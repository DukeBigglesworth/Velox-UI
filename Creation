                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = card
                })
            end

            local switch = Create("TextButton", {
                BackgroundColor3 = state and accentColor or theme.Tertiary,
                Size = UDim2.fromOffset(38, 20),
                Position = UDim2.new(1, -50, 0.5, -10),
                Text = "",
                AutoButtonColor = false,
                Parent = card
            })
            corner(switch, 10)
            AddLitStroke(switch, theme, 1, 0.6)

            local dot = Create("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.fromOffset(14, 14),
                Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
                Parent = switch
            })
            corner(dot, 7)

            local function setToggle(val)
                state = val
                playSound(Velox.Sounds.Toggle, 0.28)
                if state then
                    Tween(switch, {BackgroundColor3 = accentColor}, 0.2)
                    Tween(dot, {Position = UDim2.fromOffset(21, 3)}, 0.2)
                else
                    Tween(switch, {BackgroundColor3 = theme.Tertiary}, 0.2)
                    Tween(dot, {Position = UDim2.fromOffset(3, 3)}, 0.2)
                end
                if cb then cb(state) end
            end

            AddBouncyClick(switch, function()
                setToggle(not state)
            end)

            table.insert(accentSubscribers, function(c)
                if state then switch.BackgroundColor3 = c end
            end)

            table.insert(tabData.Elements, {Name = tName, Frame = card})
            return {
                Set = setToggle,
                Value = function() return state end
            }
