        Size = UDim2.new(1, 0, 0, 20),
        Font = Fonts.Bold,
        Text = "PLAYER CUSTOMIZER",
        TextColor3 = accentColor,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
