function Velox:CreateNametag(options)
    options = options or {}
    local player = options.Player or LocalPlayer
    local tagTitle = options.Title or "VELOX USER"
    local tagSubtitle = options.Subtitle or "Verified User"
    local tagColor = options.Color or self.Themes.Obsidian.Accent
    local tagIcon = options.Icon or self.Icons.Crown
    local heightOffset = options.Height or 2.7

    local billboard = nil
    local titleLabel = nil
    local subtitleLabel = nil
    local iconImg = nil

    local function attach(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        local old = head:FindFirstChild("VeloxNametag")
        if old then old:Destroy() end

        billboard = Instance.new("BillboardGui")
        billboard.Name = "VeloxNametag"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(180, 50)
        billboard.StudsOffset = Vector3.new(0, heightOffset, 0)
        billboard.AlwaysOnTop = true
        billboard.ResetOnSpawn = false
        billboard.Parent = head

        local pill = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(12, 13, 18),
            BackgroundTransparency = 0.15,
            Size = UDim2.fromScale(1, 1),
            ClipsDescendants = false,
            Parent = billboard
        })
        corner(pill, 10)
        AddLitStroke(pill, {BorderLight = Color3.fromRGB(255, 255, 255), Accent = tagColor, BorderDark = Color3.fromRGB(30, 30, 40)}, 1.2, 0.4)

        if tagIcon then
            iconImg = Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = tagIcon,
                ImageColor3 = tagColor,
                Size = UDim2.fromOffset(20, 20),
                Position = UDim2.fromOffset(10, 15),
                Parent = pill
            })
        end

        local textX = tagIcon and 36 or 12
        local textW = tagIcon and -44 or -24

        titleLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, textW, 0, 20),
            Position = UDim2.fromOffset(textX, 8),
            Font = Fonts.Bold,
            Text = tagTitle,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = pill
        })

        subtitleLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, textW, 0, 14),
            Position = UDim2.fromOffset(textX, 26),
            Font = Fonts.Semi,
            Text = tagSubtitle,
            TextColor3 = tagColor,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = pill
        })
    end

    if player.Character then
        task.spawn(attach, player.Character)
    end
    player.CharacterAdded:Connect(attach)

    return {
        SetTitle = function(newTitle)
            tagTitle = newTitle
            if titleLabel then titleLabel.Text = newTitle end
        end,
        SetSubtitle = function(newSub)
            tagSubtitle = newSub
            if subtitleLabel then subtitleLabel.Text = newSub end
        end,
        SetColor = function(newColor)
            tagColor = newColor
            if subtitleLabel then subtitleLabel.TextColor3 = newColor end
            if iconImg then iconImg.ImageColor3 = newColor end
        end,
        Destroy = function()
            if billboard then billboard:Destroy() end
        end
    }
end

