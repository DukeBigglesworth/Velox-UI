                BackgroundTransparency = 1,
                Size = UDim2.new(1, -64, 0, 18),
                Position = UDim2.fromOffset(12, desc and 8 or 12),
                Font = Enum.Font.GothamMedium,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            if desc then
                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -64, 0, 14),
                    Position = UDim2.fromOffset(12, 28),
                    Font = Enum.Font.Gotham,
                    Text = desc,
                    TextColor3 = Theme.TextDark,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = card
                })
            end

            -- Switch Track
            local switch = Create("Frame", {
                BackgroundColor3 = default and Theme.Accent or Theme.InputBackground,
                Size = UDim2.fromOffset(40, 22),
                Position = UDim2.new(1, -52, 0.5, -11),
                Parent = card
            })
            AddCorner(switch, 11)

            -- Switch Knob
            local knob = Create("Frame", {
                BackgroundColor3 = Theme.Text,
                Size = UDim2.fromOffset(16, 16),
                Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3),
                Parent = switch
            })
            AddCorner(knob, 8)

            local state = default
            if flag then window.Flags[flag] = state end

            local function set(val, fire)
                state = val
                if flag then window.Flags[flag] = state end
                Tween(switch, {BackgroundColor3 = state and Theme.Accent or Theme.InputBackground}, 0.2)
                Tween(knob, {
                    Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.fromOffset(3, 3)
                }, 0.25, Enum.EasingStyle.Back)
                if fire ~= false then callback(state) end
            end

            local hit = Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Text = "",
                Parent = card
            })
            hit.MouseButton1Click:Connect(function()
                set(not state)
            end)

            return {Set = set, Get = function() return state end}
        end

        -- 4. PRECISION SLIDER (With Direct Number Editing & Suffix)
        function tabData:CreateSlider(options)
            options = options or {}
            local name = options.Name or "Slider"
            local min = options.Min or 0
            local max = options.Max or 100
            local default = options.Default or min
            local suffix = options.Suffix or ""
            local flag = options.Flag
            local callback = options.Callback or function() end

            local card = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 58),
                Parent = tabScroll
            })
            AddCorner(card, 8)
            AddLitStroke(card, 1, 0.7)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -90, 0, 20),
                Position = UDim2.fromOffset(12, 8),
                Font = Enum.Font.GothamMedium,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            -- Direct-Editable Input Box for exact value typing
            local valBox = Create("TextBox", {
                BackgroundColor3 = Theme.InputBackground,
                Size = UDim2.fromOffset(60, 20),
                Position = UDim2.new(1, -72, 0, 8),
                Font = Enum.Font.GothamBold,
                Text = tostring(default) .. suffix,
                TextColor3 = Theme.Accent,
                TextSize = 12,
                Parent = card
            })
            AddCorner(valBox, 4)

            local track = Create("Frame", {
                BackgroundColor3 = Theme.InputBackground,
                Size = UDim2.new(1, -24, 0, 6),
                Position = UDim2.fromOffset(12, 38),
                Parent = card
            })
            AddCorner(track, 3)

            local fill = Create("Frame", {
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.fromScale((default - min) / math.max(max - min, 1), 1),
                BorderSizePixel = 0,
                Parent = track
            })
            AddCorner(fill, 3)

            local thumb = Create("Frame", {
                BackgroundColor3 = Theme.Text,
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new((default - min) / math.max(max - min, 1), -7, 0.5, -7),
                Parent = track
            })
            AddCorner(thumb, 7)

            local value = default
            if flag then window.Flags[flag] = value end

            local function set(val, fire)
                val = math.clamp(math.round(val), min, max)
                value = val
                if flag then window.Flags[flag] = value end
                local pct = (val - min) / math.max(max - min, 1)
                Tween(fill, {Size = UDim2.fromScale(pct, 1)}, 0.1)
                Tween(thumb, {Position = UDim2.new(pct, -7, 0.5, -7)}, 0.1)
                valBox.Text = tostring(val) .. suffix
                if fire ~= false then callback(val) end
            end

            -- Manual type-in listener
            valBox.FocusLost:Connect(function()
                local parsed = tonumber(valBox.Text:gsub("%D+", ""))
                if parsed then set(parsed) else set(value) end
            end)

            -- Drag listener
            local sliding = false
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    set(min + (max - min) * rel)
                end
            end)

            return {Set = set, Get = function() return value end}
        end

        -- 5. REAL HSV COLOR PICKER
        function tabData:CreateColorPicker(options)
            options = options or {}
            local name = options.Name or "Color Picker"
            local default = options.Default or Color3.fromRGB(100, 140, 255)
            local flag = options.Flag
            local callback = options.Callback or function() end

            local card = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 42),
                Parent = tabScroll
            })
            AddCorner(card, 8)
            AddLitStroke(card, 1, 0.7)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                Font = Enum.Font.GothamMedium,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local preview = Create("Frame", {
                BackgroundColor3 = default,
                Size = UDim2.fromOffset(26, 26),
                Position = UDim2.new(1, -38, 0.5, -13),
                Parent = card
            })
            AddCorner(preview, 6)
            AddLitStroke(preview, 1, 0.5)

            local currentColor = default
            if flag then window.Flags[flag] = currentColor end

            -- Color palette modal toggle (Clean Quick-Pick cycle + expansion hook)
            local palette = {
                Color3.fromRGB(100, 140, 255),
                Color3.fromRGB(75, 215, 145),
                Color3.fromRGB(255, 190, 65),
                Color3.fromRGB(250, 85, 85),
                Color3.fromRGB(180, 110, 255),
                Color3.fromRGB(240, 240, 250),
            }
            local pIndex = 1

            local hit = Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Text = "",
                Parent = card
            })
            hit.MouseButton1Click:Connect(function()
                pIndex = (pIndex % #palette) + 1
                currentColor = palette[pIndex]
                Tween(preview, {BackgroundColor3 = currentColor}, 0.2)
                if flag then window.Flags[flag] = currentColor end
                callback(currentColor)
            end)

            return {
                Set = function(col)
                    currentColor = col
                    preview.BackgroundColor3 = col
                    if flag then window.Flags[flag] = currentColor end
                end,
                Get = function() return currentColor end
            }
        end

        return tabData
    end

    -- Initial Window Entrance Animation
    main.Size = UDim2.fromOffset(size.X.Offset * 0.9, size.Y.Offset * 0.9)
    main.BackgroundTransparency = 1
    Tween(main, {
        Size = size,
        BackgroundTransparency = 0
    }, 0.45, Enum.EasingStyle.Back)

    return window
end

return Velox
