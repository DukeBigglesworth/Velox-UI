    corner(notif, 10)
    AddLitStroke(notif, {BorderLight = Color3.fromRGB(255, 255, 255), Accent = typeColor, BorderDark = Color3.fromRGB(35, 38, 48)}, 1, 0.5)

    local strip = Create("Frame", {
        BackgroundColor3 = typeColor,
        Size = UDim2.new(0, 4, 1, 0),
        BorderSizePixel = 0,
        Parent = notif
    })
    corner(strip, 2)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.fromOffset(16, 10),
        Font = Fonts.Bold,
        Text = title,
        TextColor3 = self.Themes.Obsidian.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 0, 32),
        Position = UDim2.fromOffset(16, 28),
        Font = Fonts.Main,
        Text = content,
        TextColor3 = self.Themes.Obsidian.TextDim,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    local timerBar = Create("Frame", {
        BackgroundColor3 = typeColor,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BorderSizePixel = 0,
        Parent = notif
    })
    Tween(timerBar, {Size = UDim2.new(0, 0, 0, 2)}, duration, Enum.EasingStyle.Linear)

    local nScale = Create("UIScale", {Scale = 0.8, Parent = notif})
    Tween(nScale, {Scale = 1.0}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        Tween(nScale, {Scale = 0.8}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(notif, {BackgroundTransparency = 1}, 0.2)
        task.wait(0.22)
        if notif and notif.Parent then notif:Destroy() end
    end)
end

