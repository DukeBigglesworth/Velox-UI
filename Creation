local function PlayVeloxLoading(parent)
    local finished = Instance.new("BindableEvent")

    local overlay = Create("Frame", {
        Name = "VeloxLoader",
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 200,
        Parent = parent
    })

    local vignette = Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://4576475447",
        ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = 0.55,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 201,
        Parent = overlay
    })

    local container = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(360, 110),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = 202,
        Parent = overlay
    })

    local letters = {"V", "E", "L", "O", "X"}
    local letterLabels = {}

    for i, char in ipairs(letters) do
        local label = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(62, 72),
            Position = UDim2.fromOffset((i - 1) * 68, 12),
            Font = Fonts.Black,
            Text = char,
            TextColor3 = Theme.Text,
            TextSize = 58,
            TextTransparency = 1,
            ZIndex = 203,
            Parent = container
        })
        local glow = Create("ImageLabel", {
            BackgroundTransparency = 1,
            Image = "rbxassetid://5028857084",
            ImageColor3 = Theme.Glow,
            ImageTransparency = 1,
            Size = UDim2.fromOffset(90, 90),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = 202,
            Parent = label
        })
        letterLabels[i] = {Label = label, Glow = glow}
    end

    local subtitle = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.fromOffset(0, 88),
        Font = Fonts.Light,
        Text = "U I   L I B R A R Y",
        TextColor3 = Theme.TextDim,
        TextSize = 13,
        TextTransparency = 1,
        ZIndex = 203,
        Parent = container
    })

    local progress = Create("Frame", {
        BackgroundColor3 = Theme.Tertiary,
        Size = UDim2.fromOffset(180, 3),
        Position = UDim2.new(0.5, -90, 1, 18),
        ZIndex = 203,
        Parent = container
    })
    AddCorner(progress, 2)
    local progressFill = Create("Frame", {
        BackgroundColor3 = Theme.Accent,
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        Parent = progress
    })
    AddCorner(progressFill, 2)

    task.spawn(function()
        for i, data in ipairs(letterLabels) do
            local label = data.Label
            local glow = data.Glow
            label.Position = UDim2.fromOffset((i - 1) * 68, 28)
            label.TextTransparency = 1
            glow.ImageTransparency = 1

            Tween(label, {
                TextTransparency = 0,
                Position = UDim2.fromOffset((i - 1) * 68, 0)
            }, 0.55, Enum.EasingStyle.Quint)

            Tween(glow, {ImageTransparency = 0.82}, 0.6)

            local scale = Create("UIScale", {Scale = 0.55, Parent = label})
            Tween(scale, {Scale = 1}, 0.6, Enum.EasingStyle.Back)

            task.wait(0.085)
        end

        Tween(subtitle, {TextTransparency = 0}, 0.5)
        Tween(progressFill, {Size = UDim2.fromScale(1, 1)}, 0.9, Enum.EasingStyle.Quint)

        task.wait(0.85)

        Tween(overlay, {BackgroundTransparency = 1}, 0.5)
        Tween(vignette, {ImageTransparency = 1}, 0.45)
        for _, data in ipairs(letterLabels) do
            Tween(data.Label, {
                TextTransparency = 1,
                Position = data.Label.Position - UDim2.fromOffset(0, 18)
            }, 0.4)
            Tween(data.Glow, {ImageTransparency = 1}, 0.35)
        end
        Tween(subtitle, {TextTransparency = 1}, 0.3)
        Tween(progress, {BackgroundTransparency = 1}, 0.3)
        Tween(progressFill, {BackgroundTransparency = 1}, 0.3)

        task.wait(0.55)
        overlay:Destroy()
        finished:Fire()
    end)

    return finished
end

