function Velox.LoadWebAsset(url)
    if not url or url == "" then return "" end
    if type(url) == "number" or (not url:find("^https?://") and not url:find("^data:")) then
        if tonumber(url) then return "rbxassetid://" .. url end
        return url
    end

    local imgParam = url:match("imgurl=([^&]+)")
    if imgParam then
        pcall(function()
            local decoded = HttpService:UrlDecode(imgParam)
            if decoded and decoded ~= "" then url = decoded end
        end)
    end

    if url:find("imgur%.com/%w+$") then
        local id = url:match("imgur%.com/(%w+)$")
        if id then url = "https://i.imgur.com/" .. id .. ".png" end
    end

    if url:find("^data:image/[%w%+]+;base64,") then
        local b64 = url:match("^data:image/[%w%+]+;base64,(.+)$")
        if b64 and writefile and getcustomasset then
            local decoded = nil
            pcall(function()
                if syn and syn.crypt and syn.crypt.base64 then
                    decoded = syn.crypt.base64.decode(b64)
                elseif crypt and crypt.base64decode then
                    decoded = crypt.base64decode(b64)
                end
            end)
            if decoded and #decoded > 20 then
                local fileName = "velox_data_" .. tostring(#decoded) .. ".png"
                pcall(function() writefile(fileName, decoded) end)
                local aOk, asset = pcall(function() return getcustomasset(fileName) end)
                if aOk and asset then return asset end
            end
        end
    end

    local req = (syn and syn.request) or (http and http.request) or request or http_request
    if req and writefile and getcustomasset then
        local hash = 0
        for i = 1, #url do
            hash = (hash * 31 + string.byte(url, i)) % 2147483647
        end
        local fileName = "velox_web_" .. string.format("%08X", hash) .. ".png"

        local ok, res = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
                    ["Accept"] = "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
                    ["Accept-Encoding"] = "gzip, deflate, br",
                    ["Referer"] = "https://www.google.com/"
                }
            })
        end)

        if ok and res and res.StatusCode >= 200 and res.StatusCode < 300 and res.Body and #res.Body > 50 then
            pcall(function() writefile(fileName, res.Body) end)
            local aOk, assetId = pcall(function() return getcustomasset(fileName) end)
            if aOk and assetId then return assetId end
        end
    end

    return url
end

local function MakeDraggable(handle, target)
    target = target or handle
    local dragging = false
    local dragInput, dragStart, startAbs

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startAbs = target.AbsolutePosition
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and startAbs then
            local delta = input.Position - dragStart
            local newX = startAbs.X + delta.X
            local newY = startAbs.Y + delta.Y
            local cam = workspace.CurrentCamera
            if cam then
                local vs = cam.ViewportSize
                local sz = target.AbsoluteSize
                newX = math.clamp(newX, 0, math.max(0, vs.X - sz.X))
                newY = math.clamp(newY, 0, math.max(0, vs.Y - sz.Y))
            end
            target.Position = UDim2.fromOffset(newX, newY)
            target.AnchorPoint = Vector2.new(0, 0)
        end
    end)
end

local function AddLitStroke(parent, theme, width, trans)
    local stroke = Create("UIStroke", {
        Color = theme.Accent or theme.BorderLight or Color3.fromRGB(90, 140, 255),
        Thickness = width or 1.2,
        Transparency = trans or 0.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
    return stroke
end

local function AddBouncyClick(btn, cb)
    local scale = btn:FindFirstChildOfClass("UIScale") or Create("UIScale", {Scale = 1, Parent = btn})
    btn.MouseButton1Down:Connect(function()
        Tween(scale, {Scale = 0.94}, 0.1, Enum.EasingStyle.Quad)
    end)
    btn.MouseButton1Up:Connect(function()
        Tween(scale, {Scale = 1.05}, 0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        task.delay(0.15, function()
            Tween(scale, {Scale = 1}, 0.12)
        end)
        playSound(Velox.Sounds.Click, 0.4)
        if cb then cb() end
    end)
    btn.MouseLeave:Connect(function()
        Tween(scale, {Scale = 1}, 0.12)
    end)
end

function Velox:PlayLoadingScreen(theme, onComplete)
    local themeObj = theme or self.Themes.Obsidian
    local screen = Create("ScreenGui", {
        Name = "Velox_CinemaLoader",
        DisplayOrder = 9999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        Parent = GuiParent,
    })

    local canvas = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = screen,
    })

    local letters = {"V", "E", "L", "O", "X", " ", "U", "I"}
    local letterSpacings = {-150, -90, -35, 20, 80, 120, 150, 200}
    local letterLabels = {}

    playSound(self.Sounds.Atmosphere, 0.7, 0.95)

    for i, char in ipairs(letters) do
        if char ~= " " then
            local lbl = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(80, 80),
                Position = UDim2.fromScale(0.5, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Font = Fonts.Black,
                Text = char,
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextSize = 58,
                TextTransparency = 1,
                Parent = canvas,
            })
            local letterScale = Create("UIScale", {Scale = 0.1, Parent = lbl})
            letterLabels[i] = {Label = lbl, Scale = letterScale, TargetX = letterSpacings[i]}
        end
    end

    local subTitle = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(400, 30),
        Position = UDim2.new(0.5, 0, 0.5, 64),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Font = Fonts.Semi,
        Text = "L I B R A R Y   B Y   S C H W E I N",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 14,
        TextTransparency = 1,
        Parent = canvas,
    })

    task.spawn(function()
        task.wait(0.2)
        for i, data in pairs(letterLabels) do
            task.spawn(function()
                playSound(Velox.Sounds.Materialize, 0.45, 0.9 + (i * 0.08))
                Tween(data.Label, {
                    Position = UDim2.new(0.5, data.TargetX, 0.5, -10),
                    TextTransparency = 0,
                    TextColor3 = (i <= 5) and Color3.fromRGB(255, 255, 255) or themeObj.Accent
                }, 0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                Tween(data.Scale, {Scale = 1.0}, 0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end)
            task.wait(0.14)
        end

        task.wait(0.35)
        playSound(Velox.Sounds.Harmonic, 0.6, 1.0)
        Tween(subTitle, {TextTransparency = 0}, 0.8, Enum.EasingStyle.Quad)

        local pulseStart = tick()
        local pulseConn
        pulseConn = RunService.RenderStepped:Connect(function()
            local elapsed = tick() - pulseStart
            local wave = (math.sin(elapsed * 4) + 1) / 2
            subTitle.TextColor3 = Color3.fromRGB(
                math.floor(themeObj.Accent.R * 255 * (0.8 + 0.2 * wave)),
                math.floor(themeObj.Accent.G * 255 * (0.8 + 0.2 * wave)),
                math.floor(themeObj.Accent.B * 255 * (0.8 + 0.2 * wave))
            )
        end)

        task.wait(2.2)
        if pulseConn then pulseConn:Disconnect() end

        for _, data in pairs(letterLabels) do
            Tween(data.Label, {
                Position = UDim2.new(0.5, data.TargetX * 1.6, 0.5, -40),
                TextTransparency = 1
            }, 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            Tween(data.Scale, {Scale = 1.4}, 0.6, Enum.EasingStyle.Quad)
        end
        Tween(subTitle, {TextTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 90)}, 0.5, Enum.EasingStyle.Quad)

        task.wait(0.65)
        screen:Destroy()
        if onComplete then onComplete() end
    end)
end

