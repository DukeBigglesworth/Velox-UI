end

function Velox:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Notice"
    local content = opts.Content or ""
    local duration = opts.Duration or 3.5
    local nType = opts.Type or "Info"

    ensureNotifs()
    playSound(self.Sounds.Notify, 0.35)

    local col = self.Themes.Obsidian.Info
    local iconId = self.Icons.Info
    if nType == "Success" then col = self.Themes.Obsidian.Success; iconId = self.Icons.Check
    elseif nType == "Warning" then col = self.Themes.Obsidian.Warning; iconId = self.Icons.Alert
    elseif nType == "Error" then col = self.Themes.Obsidian.Error; iconId = self.Icons.Cross end

    local notif = Create("Frame", {
        BackgroundColor3 = self.Themes.Obsidian.Secondary,
        Size = UDim2.new(1, 0, 0, 68),
        Position = UDim2.new(1, 100, 0, 0),
        ClipsDescendants = true,
        Parent = notifHolder
    })
    corner(notif, 10)
    AddLitStroke(notif, self.Themes.Obsidian, 1, 0.6)

    local iconBg = Create("Frame", {
        BackgroundColor3 = col,
        BackgroundTransparency = 0.85,
        Size = UDim2.fromOffset(34, 34),
        Position = UDim2.fromOffset(12, 16),
        Parent = notif
    })
    corner(iconBg, 8)

    Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = col,
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = iconBg
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 0, 18),
        Position = UDim2.fromOffset(54, 13),
        Font = Fonts.Bold,
        Text = title,
        TextColor3 = self.Themes.Obsidian.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 0, 30),
        Position = UDim2.fromOffset(54, 31),
        Font = Fonts.Main,
        Text = content,
        TextColor3 = self.Themes.Obsidian.TextDim,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = notif
    })

    local timerBar = Create("Frame", {
        BackgroundColor3 = col,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BorderSizePixel = 0,
        Parent = notif
    })

    Tween(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.4, Enum.EasingStyle.Back)
    Tween(timerBar, {Size = UDim2.new(0, 0, 0, 2)}, duration, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        Tween(notif, {Position = UDim2.new(1, 60, 0, 0), BackgroundTransparency = 1}, 0.3)
        task.wait(0.3)
        if notif and notif.Parent then notif:Destroy() end
    end)
end

