    local typeColor = colors[notifType] or colors.Info

    local notif = Create("Frame", {
        BackgroundColor3 = self.Themes.Obsidian.Secondary,
        Size = UDim2.fromOffset(300, 72),
        ClipsDescendants = true,
        Parent = notifHolder
