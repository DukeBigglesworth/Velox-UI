        function tabData:CreateInput(options)
            options = options or {}
            local name = options.Name or "Input"
            local placeholder = options.Placeholder or "Type here..."
            local default = options.Default or ""
            local flag = options.Flag
            local callback = options.Callback or function() end

            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 70),
                Parent = tabContent
            })
            AddCorner(frame, 8)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -20, 0, 22),
                Position = UDim2.fromOffset(14, 6),
                Font = Fonts.Main,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })

            local box = Create("TextBox", {
                BackgroundColor3 = Theme.Quaternary,
                Size = UDim2.new(1, -28, 0, 30),
                Position = UDim2.fromOffset(14, 32),
                Font = Fonts.Main,
                Text = default,
                PlaceholderText = placeholder,
                PlaceholderColor3 = Theme.TextDark,
                TextColor3 = Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent = frame
            })
            AddCorner(box, 6)
            AddPadding(box, 10, 10, 0, 0)

            if flag then windowObject.Flags[flag] = default end

            box.FocusLost:Connect(function()
                if flag then windowObject.Flags[flag] = box.Text end
                callback(box.Text)
            end)

            return {
                Set = function(t)
                    box.Text = t
                    if flag then windowObject.Flags[flag] = t end
                end,
                Get = function() return box.Text end
            }
        end

        return tabData
    end

    -- Final open animation
    Tween(main, {
        Size = size,
        BackgroundTransparency = 0
    }, 0.55, Enum.EasingStyle.Quint)
    Tween(shadow, {ImageTransparency = 0.45}, 0.5)

    return windowObject
end

return Velox
