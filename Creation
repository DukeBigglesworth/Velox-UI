    local subTitle     = cfg.SubTitle or "v2.0 • Premium Edition"
    local size         = cfg.Size or UDim2.fromOffset(680, 480)
    local minKey       = cfg.MinimizeKey or Enum.KeyCode.RightControl
    local themeKey     = cfg.Theme or "Obsidian"
    local orientation  = cfg.Orientation or "Vertical"
    local showProfile  = cfg.ShowProfile ~= false
    local showSearch   = cfg.ShowSearch ~= false
    local showSettings = cfg.ShowSettings ~= false
    local showMobileToggle = cfg.MobileToggle ~= false
    local customRole   = cfg.Role or "Owner"
    local bgImgUrl     = cfg.BackgroundImage or ""
    local logoImgUrl   = cfg.Logo or ""

    self.ActiveRole = customRole
    local nametagMode = cfg.Nametags
    if nametagMode == true then
        self.NametagsEnabled = true
    elseif nametagMode == "custom" then
        self.NametagsEnabled = true
    else
        self.NametagsEnabled = false
    end
    local theme = self.Themes[themeKey] or self.Themes.Obsidian
    local accentColor = theme.Accent

    local accentSubscribers = {}
    local function notifyAccentChange(newCol)
        accentColor = newCol
        for _, fn in ipairs(accentSubscribers) do fn(newCol) end
    end

    if nametagMode == true then
        local def = cfg.DefaultNametag or {}
        def.Role = customRole
