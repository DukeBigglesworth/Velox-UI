function Velox:Notify(options)
    options = options or {}
    local title = options.Title or "Notice"
    local content = options.Content or ""
    local duration = options.Duration or 3.5
    local notifType = options.Type or "Info"

    EnsureNotificationHolder()

    local accentColor = Theme.Info
    local iconId = Icons.Info
    if notifType == "Success" then accentColor = Theme.Success; iconId = Icons.Check
    elseif notifType == "Warning" then accentColor = Theme.Warning; iconId = Icons.Alert
    elseif notifType == "Error" then accentColor = Theme.Error; iconId = Icons.Cross end

    local notif = Create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.new(1, 0, 0, 72),
        Position = UDim2.new(1, 100, 0, 0),
        ClipsDescendants = true,
        Parent = NotificationHolder
    })
    AddCorner(notif, 10)
    AddLitStroke(notif, 1, 0.6)

    -- Left Icon Indicator
    local iconBg = Create("Frame", {
        BackgroundColor3 = accentColor,
        BackgroundTransparency = 0.85,
        Size = UDim2.fromOffset(36, 36),
        Position = UDim2.fromOffset(12, 18),
        Parent = notif
    })
    AddCorner(iconBg, 8)

    Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = accentColor,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = iconBg
    })

    -- Text
    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -64, 0, 18),
        Position = UDim2.fromOffset(56, 14),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -64, 0, 32),
        Position = UDim2.fromOffset(56, 32),
        Font = Enum.Font.GothamMedium,
        Text = content,
        TextColor3 = Theme.TextDim,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = notif
    })

    -- Countdown Progress Line
    local timerBar = Create("Frame", {
        BackgroundColor3 = accentColor,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BorderSizePixel = 0,
        Parent = notif
    })

    -- Slide In
    notif.Position = UDim2.new(1, 100, 0, 0)
    Tween(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.4, Enum.EasingStyle.Back)
    Tween(timerBar, {Size = UDim2.new(0, 0, 0, 2)}, duration, Enum.EasingStyle.Linear)

    local function dismiss()
        Tween(notif, {Position = UDim2.new(1, 50, 0, 0), BackgroundTransparency = 1}, 0.3)
        task.wait(0.3)
        notif:Destroy()
    end

    task.delay(duration, dismiss)
end

