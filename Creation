-- 4. MOBILE TOGGLE PILL (Ensures Mobile Users Can Always Restore UI)
----------------------------------------------------------------
function Velox:CreateMobileToggle(onToggle)
    local toggleGui = Create("ScreenGui", {
        Name = "Velox_MobileToggle",
        DisplayOrder = 100,
        ResetOnSpawn = false,
        Parent = GuiParent
    })

    local bubble = Create("TextButton", {
        Name = "VeloxBubble",
        BackgroundColor3 = Color3.fromRGB(15, 17, 23),
        Size = UDim2.fromOffset(44, 44),
        Position = UDim2.fromOffset(18, 120),
        Text = "",
        AutoButtonColor = false,
        Parent = toggleGui
    })
    corner(bubble, 22)
    AddLitStroke(bubble, self.Themes.Obsidian, 1.2, 0.4)
    MakeDraggable(bubble, bubble)

    local icon = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Fonts.Black,
        Text = "V",
        TextColor3 = self.Themes.Obsidian.Accent,
        TextSize = 22,
        Parent = bubble
    })

    AddBouncyClick(bubble, function()
        if onToggle then onToggle() end
    end)

    return toggleGui
end

