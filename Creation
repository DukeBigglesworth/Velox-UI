        function tabData:CreateSlider(opts)
            opts = opts or {}
            local sName = opts.Name or "Slider"
            local min = opts.Min or 0
            local max = opts.Max or 100
            local def = opts.Default or min
            local suffix = opts.Suffix or ""
            local cb = opts.Callback
            local currentVal = def

            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 52),
                Parent = tabContainer
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            local nameLbl = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -80, 0, 20),
                Position = UDim2.fromOffset(12, 6),
                Font = Fonts.Semi,
                Text = sName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local valLbl = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(60, 20),
                Position = UDim2.new(1, -72, 0, 6),
                Font = Fonts.Bold,
                Text = tostring(currentVal) .. suffix,
                TextColor3 = accentColor,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = card
            })
            table.insert(accentSubscribers, function(c) valLbl.TextColor3 = c end)

            local track = Create("Frame", {
                BackgroundColor3 = theme.Quaternary,
                Size = UDim2.new(1, -24, 0, 6),
                Position = UDim2.fromOffset(12, 32),
                Parent = card
            })
            corner(track, 3)

            local fill = Create("Frame", {
                BackgroundColor3 = accentColor,
                Size = UDim2.fromScale(math.clamp((def - min) / (max - min), 0, 1), 1),
                BorderSizePixel = 0,
                Parent = track
            })
            corner(fill, 3)
            table.insert(accentSubscribers, function(c) fill.BackgroundColor3 = c end)

            local dragging = false
            local function updateSlider(inp)
                local rel = math.clamp((inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.fromScale(rel, 1)
                local val = math.floor(min + (rel * (max - min)))
                currentVal = val
                valLbl.Text = tostring(val) .. suffix
                if cb then cb(val) end
            end

            track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(inp)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(inp)
                end
            end)

            table.insert(tabData.Elements, {Name = sName, Frame = card})
            return {
                Set = function(newVal)
                    currentVal = math.clamp(newVal, min, max)
                    local rel = (currentVal - min) / (max - min)
                    fill.Size = UDim2.fromScale(rel, 1)
                    valLbl.Text = tostring(currentVal) .. suffix
                    if cb then cb(currentVal) end
                end,
                Value = function() return currentVal end
            }
        end

        function tabData:CreateDropdown(opts)
            opts = opts or {}
            local dName = opts.Name or "Dropdown"
            local items = opts.Items or {}
            local isMulti = opts.MultiSelect or false
            local cb = opts.Callback
            local selected = isMulti and {} or (opts.Default or items[1] or "Select...")
            local isOpen = false

            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 38),
                ClipsDescendants = false,
                Parent = tabContainer
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 140, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                Font = Fonts.Semi,
                Text = dName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local trigger = Create("TextButton", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.new(0, 150, 0, 26),
                Position = UDim2.new(1, -162, 0.5, -13),
                Text = "",
                AutoButtonColor = false,
                Parent = card
            })
            corner(trigger, 6)
            AddLitStroke(trigger, theme, 1, 0.6)

            local displayLabel = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -26, 1, 0),
                Position = UDim2.fromOffset(8, 0),
                Font = Fonts.Main,
                Text = isMulti and "Select items..." or tostring(selected),
                TextColor3 = theme.TextDim,
                TextSize = 11,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = trigger
            })

            local dropIcon = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.new(1, -20, 0.5, -8),
                Font = Fonts.Bold,
                Text = "▼",
                TextColor3 = theme.TextDark,
                TextSize = 9,
                Parent = trigger
            })

            local dropList = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, 0, 0, math.min(#items * 28 + 6, 140)),
                Position = UDim2.new(0, 0, 1, 4),
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 30,
                Parent = trigger
            })
            corner(dropList, 8)
            AddLitStroke(dropList, theme, 1, 0.5)

            local dropScroll = Create("ScrollingFrame", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                CanvasSize = UDim2.new(0, 0, 0, #items * 28 + 6),
                ScrollBarThickness = 2,
                BorderSizePixel = 0,
                ZIndex = 31,
                Parent = dropList
            })
            list(dropScroll, 2)
            pad(dropScroll, 4, 4, 4, 4)

            local function renderDropdownItems()
                for _, child in ipairs(dropScroll:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, item in ipairs(items) do
                    local itmBtn = Create("TextButton", {
                        BackgroundColor3 = theme.Tertiary,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 26),
                        Font = Fonts.Main,
                        Text = "  " .. tostring(item),
                        TextColor3 = theme.TextDim,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false,
                        ZIndex = 32,
                        Parent = dropScroll
                    })
                    corner(itmBtn, 5)

                    if not isMulti and item == selected then
                        itmBtn.TextColor3 = accentColor
                        itmBtn.BackgroundTransparency = 0.5
                    elseif isMulti and selected[item] then
                        itmBtn.TextColor3 = accentColor
                        itmBtn.BackgroundTransparency = 0.5
                    end

                    AddBouncyClick(itmBtn, function()
                        if isMulti then
                            selected[item] = not selected[item]
                            local selList = {}
                            for k, v in pairs(selected) do if v then table.insert(selList, k) end end
                            displayLabel.Text = #selList > 0 and table.concat(selList, ", ") or "Select items..."
                            if cb then cb(selected) end
                        else
                            selected = item
                            displayLabel.Text = tostring(item)
                            dropList.Visible = false
                            dropIcon.Text = "▼"
                            if cb then cb(item) end
                        end
                        renderDropdownItems()
                    end)
                end
            end

            AddBouncyClick(trigger, function()
                isOpen = not isOpen
                dropList.Visible = isOpen
                dropIcon.Text = isOpen and "▲" or "▼"
                if isOpen then renderDropdownItems() end
            end)

            table.insert(tabData.Elements, {Name = dName, Frame = card})
            return {
                Set = function(val)
                    selected = val
                    displayLabel.Text = tostring(val)
                    if cb then cb(val) end
                end,
                Refresh = function(newItems)
                    items = newItems or {}
                    dropList.Size = UDim2.new(1, 0, 0, math.min(#items * 28 + 6, 140))
                    dropScroll.CanvasSize = UDim2.new(0, 0, 0, #items * 28 + 6)
                    renderDropdownItems()
                end,
                Value = function() return selected end
            }
        end

        function tabData:CreateKeybind(opts)
            opts = opts or {}
            local kName = opts.Name or "Keybind"
            local currentKey = opts.Default or Enum.KeyCode.F
            local cb = opts.Callback
            local listening = false

            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 38),
                Parent = tabContainer
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 160, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                Font = Fonts.Semi,
                Text = kName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local keyBtn = Create("TextButton", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.fromOffset(70, 24),
                Position = UDim2.new(1, -82, 0.5, -12),
                Font = Fonts.Bold,
                Text = currentKey.Name,
                TextColor3 = accentColor,
                TextSize = 11,
                AutoButtonColor = false,
                Parent = card
            })
            corner(keyBtn, 6)
            AddLitStroke(keyBtn, theme, 1, 0.6)
            table.insert(accentSubscribers, function(c) keyBtn.TextColor3 = c end)

            AddBouncyClick(keyBtn, function()
                listening = true
                keyBtn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    listening = false
                    keyBtn.Text = currentKey.Name
                    playSound(Velox.Sounds.Click, 0.3)
                    if cb then cb(currentKey) end
                elseif not gpe and not listening and inp.KeyCode == currentKey then
                    if cb then cb(currentKey) end
                end
            end)

            table.insert(tabData.Elements, {Name = kName, Frame = card})
            return {
                Set = function(newKey)
                    currentKey = newKey
                    keyBtn.Text = newKey.Name
                end,
                Value = function() return currentKey end
            }
        end

        return tabData
    end

