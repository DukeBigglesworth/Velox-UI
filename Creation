                    update(inp)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    update(inp)
                end
            end)

            table.insert(tabData.Elements, {Name = sName, Frame = card})
            return {
                Set = function(newVal)
                    curVal = math.clamp(newVal, minVal, maxVal)
                    valLbl.Text = tostring(curVal) .. suffix
                    fill.Size = UDim2.fromScale((curVal - minVal) / (maxVal - minVal), 1)
                    if cb then cb(curVal) end
                end,
                Value = function() return curVal end,
            }
        end

        function tabData:CreateDropdown(opts)
            opts = opts or {}
            local dName = opts.Name or "Dropdown"
            local items = opts.Items or {}
            local isMulti = opts.MultiSelect or false
            local cur = opts.Default or (isMulti and {} or items[1])
            local cb = opts.Callback

            local open = false
            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 48),
                ClipsDescendants = true,
                Parent = tabContainer,
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0.5, 0, 0, 20),
                Position = UDim2.fromOffset(12, 14),
                Font = Fonts.Semi,
                Text = dName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card,
            })

            local trigger = Create("TextButton", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.new(0.46, 0, 0, 26),
                Position = UDim2.new(0.52, 0, 0, 11),
                Font = Fonts.Main,
                Text = "",
                AutoButtonColor = false,
                Parent = card,
            })
            corner(trigger, 6)
            AddLitStroke(trigger, theme, 1, 0.6)

            local triggerLbl = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -24, 1, 0),
                Position = UDim2.fromOffset(8, 0),
                Font = Fonts.Semi,
                Text = isMulti and "Select..." or tostring(cur),
                TextColor3 = theme.Text,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = trigger,
            })

            local chevron = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.new(1, -20, 0.5, -8),
                Font = Fonts.Bold,
                Text = "▼",
                TextColor3 = theme.TextDark,
                TextSize = 8,
                Parent = trigger,
            })

            local dropList = Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -24, 0, #items * 28),
                Position = UDim2.fromOffset(12, 48),
                Parent = card,
            })
            list(dropList, 4)

            for _, item in ipairs(items) do
                local itemBtn = Create("TextButton", {
                    BackgroundColor3 = theme.Tertiary,
                    Size = UDim2.new(1, 0, 0, 24),
                    Font = Fonts.Main,
                    Text = "  " .. tostring(item),
                    TextColor3 = theme.TextDim,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = dropList,
                })
                corner(itemBtn, 4)

                AddBouncyClick(itemBtn, function()
                    if isMulti then
                        if not cur[item] then cur[item] = true else cur[item] = nil end
                        local selectedCount = 0
                        for _ in pairs(cur) do selectedCount = selectedCount + 1 end
                        triggerLbl.Text = selectedCount .. " Selected"
                        if cb then cb(cur) end
                    else
                        cur = item
                        triggerLbl.Text = tostring(item)
                        open = false
                        Tween(card, {Size = UDim2.new(1, -6, 0, 48)}, 0.2)
                        chevron.Text = "▼"
                        if cb then cb(cur) end
                    end
                end)
            end

            AddBouncyClick(trigger, function()
                open = not open
                chevron.Text = open and "▲" or "▼"
                local targetH = open and (52 + (#items * 28)) or 48
                Tween(card, {Size = UDim2.new(1, -6, 0, targetH)}, 0.25)
            end)

            table.insert(tabData.Elements, {Name = dName, Frame = card})
            return {
                Set = function(val)
                    cur = val
                    triggerLbl.Text = isMulti and "Updated" or tostring(val)
                end,
                Value = function() return cur end
            }
        end

        function tabData:CreateKeybind(opts)
            opts = opts or {}
            local kName = opts.Name or "Keybind"
            local currentKey = opts.Default or Enum.KeyCode.F
            local cb = opts.Callback
            local listening = false

            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 38),
                Parent = tabContainer
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 160, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                Font = Fonts.Semi,
                Text = kName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local keyBtn = Create("TextButton", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.fromOffset(70, 24),
                Position = UDim2.new(1, -82, 0.5, -12),
                Font = Fonts.Bold,
                Text = currentKey.Name,
                TextColor3 = accentColor,
                TextSize = 11,
                AutoButtonColor = false,
                Parent = card
            })
            corner(keyBtn, 6)
            AddLitStroke(keyBtn, theme, 1, 0.6)
            table.insert(accentSubscribers, function(c) keyBtn.TextColor3 = c end)

            AddBouncyClick(keyBtn, function()
                listening = true
                keyBtn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    listening = false
                    keyBtn.Text = currentKey.Name
                    playSound(Velox.Sounds.Click, 0.3)
                    if cb then cb(currentKey) end
                elseif not gpe and not listening and inp.KeyCode == currentKey then
                    if cb then cb(currentKey) end
                end
            end)

            table.insert(tabData.Elements, {Name = kName, Frame = card})
            return {
                Set = function(newKey)
                    currentKey = newKey
                    keyBtn.Text = newKey.Name
                end,
                Value = function() return currentKey end
            }
        end

        return tabData
    end

    task.spawn(function()
        Velox:PlayLoadingScreen(theme, function()
            main.Visible = true
            mainScale.Scale = 0.85
            Tween(mainScale, {Scale = 1.0}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
    end)

    return win
end

function Velox.createUI(width, height, position, title, themeKey)
    local theme = Velox.Themes[themeKey or "Obsidian"] or Velox.Themes.Obsidian
    local w = width or 400
    local h = height or 300
    local pos = position or UDim2.fromScale(0.5, 0.5)

    local gui = Create("ScreenGui", {
        Name = "Velox_Custom_" .. HttpService:GenerateGUID(false):sub(1, 8),
        ResetOnSpawn = false,
        DisplayOrder = 50,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = GuiParent
    })

    local frame = Create("Frame", {
        Name = "VeloxCustomFrame",
        BackgroundColor3 = theme.Background,
        Size = UDim2.fromOffset(w, h),
        Position = pos,
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = false,
        Parent = gui
    })
    corner(frame, 12)
    AddLitStroke(frame, theme, 1, 0.5)

    Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = theme.Shadow,
        ImageTransparency = 0.4,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, 40, 1, 40),
        Position = UDim2.fromOffset(-20, -20),
        ZIndex = 0,
        Parent = frame
    })

    local titleBar = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, 40),
        Parent = frame
    })
    corner(titleBar, 12)
    MakeDraggable(titleBar, frame)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        Font = Fonts.Bold,
        Text = title or "CUSTOM INTERFACE",
        TextColor3 = theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar
    })

    local closeB = Create("TextButton", {
        BackgroundColor3 = theme.Tertiary,
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(1, -32, 0.5, -12),
        Font = Fonts.Bold,
        Text = "×",
        TextColor3 = theme.TextDim,
        TextSize = 16,
        AutoButtonColor = false,
        Parent = titleBar
    })
    corner(closeB, 6)
    AddBouncyClick(closeB, function() gui:Destroy() end)

    local minB = Create("TextButton", {
        BackgroundColor3 = theme.Tertiary,
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(1, -60, 0.5, -12),
        Font = Fonts.Bold,
        Text = "–",
        TextColor3 = theme.TextDim,
        TextSize = 16,
        AutoButtonColor = false,
        Parent = titleBar
    })
    corner(minB, 6)

    local container = Create("ScrollingFrame", {
        Name = "Container",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -50),
        Position = UDim2.fromOffset(10, 44),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2,
        BorderSizePixel = 0,
        Parent = frame
    })
    local layout = list(container, 6)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    local minimized = false
    local origSize = UDim2.fromOffset(w, h)
    AddBouncyClick(minB, function()
        minimized = not minimized
        if minimized then
            container.Visible = false
            Tween(frame, {Size = UDim2.fromOffset(w, 40)}, 0.25)
        else
            container.Visible = true
            Tween(frame, {Size = origSize}, 0.3, Enum.EasingStyle.Quint)
        end
    end)

    local customUI = {
        Gui = gui,
        Frame = frame,
        Container = container,
        Theme = theme,
    }

    function customUI:AddCard(opts)
        opts = opts or {}
        local card = Create("Frame", {
            BackgroundColor3 = opts.Color or theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 50),
            Parent = container
        })
        corner(card, opts.Radius or 8)
        AddLitStroke(card, theme, 1, 0.75)
        return card
    end

    function customUI:AddButton(opts)
        opts = opts or {}
        local btn = Create("TextButton", {
            BackgroundColor3 = opts.Color or theme.Tertiary,
            Size = opts.Size or UDim2.new(1, 0, 0, 36),
            Font = Fonts.Bold,
            Text = opts.Text or "Button",
            TextColor3 = theme.Text,
            TextSize = 11,
            AutoButtonColor = false,
            Parent = container
        })
        corner(btn, opts.Radius or 8)
        AddLitStroke(btn, theme, 1, 0.6)
        AddBouncyClick(btn, opts.Callback)
        return btn
    end

    function customUI:AddToggle(opts)
        opts = opts or {}
        local state = opts.Default or false
        local card = Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 36),
            Parent = container
        })
        corner(card, 8)
        AddLitStroke(card, theme, 1, 0.75)

        Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -50, 1, 0),
            Position = UDim2.fromOffset(10, 0),
            Font = Fonts.Semi,
            Text = opts.Text or "Toggle",
            TextColor3 = theme.Text,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        local sw = Create("TextButton", {
            BackgroundColor3 = state and theme.Accent or theme.Tertiary,
            Size = UDim2.fromOffset(36, 18),
            Position = UDim2.new(1, -44, 0.5, -9),
            Text = "",
            AutoButtonColor = false,
            Parent = card
        })
        corner(sw, 9)
        local d = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size = UDim2.fromOffset(12, 12),
            Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
            Parent = sw
        })
        corner(d, 6)

        AddBouncyClick(sw, function()
            state = not state
            playSound(Velox.Sounds.Toggle, 0.28)
            if state then
                Tween(sw, {BackgroundColor3 = theme.Accent}, 0.2)
                Tween(d, {Position = UDim2.fromOffset(21, 3)}, 0.2)
            else
                Tween(sw, {BackgroundColor3 = theme.Tertiary}, 0.2)
                Tween(d, {Position = UDim2.fromOffset(3, 3)}, 0.2)
            end
            if opts.Callback then opts.Callback(state) end
        end)

        return card
    end

    return customUI
end

if getgenv then
    getgenv().Velox = Velox
end

return Velox
