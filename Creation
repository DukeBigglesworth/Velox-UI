function Velox:CreateWindow(config)
    config = config or {}
    local title       = config.Title or "Velox UI"
    local size        = config.Size or UDim2.fromOffset(620, 460)
    local minimizeKey = config.MinimizeKey or Enum.KeyCode.RightControl

    local screenGui = Create("ScreenGui", {
        Name = "Velox_" .. HttpService:GenerateGUID(false):sub(1, 8),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 50,
        Parent = (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui")) or CoreGui
    })

    -- Play loading and WAIT until it finishes
    local loadingFinished = PlayVeloxLoading(screenGui)
    loadingFinished.Event:Wait()

    --------------------------------------------------------
    -- MAIN FRAME
    --------------------------------------------------------
    local main = Create("Frame", {
        Name = "Main",
        BackgroundColor3 = Theme.Background,
        Size = UDim2.fromOffset(0, 0),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = screenGui
    })
    AddCorner(main, 14)
    AddStroke(main, Theme.Stroke, 1, 0.35)

    local shadow = Create("ImageLabel", {
        Name = "Shadow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Theme.Shadow,
        ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, 56, 1, 56),
        Position = UDim2.fromOffset(-28, -28),
        ZIndex = 0,
        Parent = main
    })

    --------------------------------------------------------
    -- TITLE BAR
    --------------------------------------------------------
    local titleBar = Create("Frame", {
        Name = "TitleBar",
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.new(1, 0, 0, 46),
        BorderSizePixel = 0,
        Parent = main
    })
    AddCorner(titleBar, 14)
    Create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 16),
        Position = UDim2.fromOffset(0, 30),
        Parent = titleBar
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.fromOffset(18, 0),
        Font = Fonts.Bold,
        Text = title,
        TextColor3 = Theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar
    })

    local closeBtn = Create("TextButton", {
        Name = "Close",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.new(1, -44, 0.5, -19),
        Font = Fonts.Bold,
        Text = "×",
        TextColor3 = Theme.TextDim,
        TextSize = 24,
        AutoButtonColor = false,
        Parent = titleBar
    })
    closeBtn.MouseEnter:Connect(function()
        Tween(closeBtn, {TextColor3 = Theme.Error}, 0.2)
    end)
    closeBtn.MouseLeave:Connect(function()
        Tween(closeBtn, {TextColor3 = Theme.TextDim}, 0.2)
    end)

    local minBtn = Create("TextButton", {
        Name = "Minimize",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.new(1, -82, 0.5, -19),
        Font = Fonts.Bold,
        Text = "–",
        TextColor3 = Theme.TextDim,
        TextSize = 22,
        AutoButtonColor = false,
        Parent = titleBar
    })
    minBtn.MouseEnter:Connect(function()
        Tween(minBtn, {TextColor3 = Theme.Text}, 0.2)
    end)
    minBtn.MouseLeave:Connect(function()
        Tween(minBtn, {TextColor3 = Theme.TextDim}, 0.2)
    end)

    --------------------------------------------------------
    -- TAB + CONTENT
    --------------------------------------------------------
    local tabContainer = Create("Frame", {
        Name = "TabContainer",
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.new(0, 148, 1, -46),
        Position = UDim2.fromOffset(0, 46),
        BorderSizePixel = 0,
        Parent = main
    })

    local tabList = Create("ScrollingFrame", {
        Name = "TabList",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 1, -16),
        Position = UDim2.fromOffset(6, 8),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.AccentDim,
        BorderSizePixel = 0,
        Parent = tabContainer
    })
    local tabListLayout = AddListLayout(tabList, 4)
    AddPadding(tabList, 0, 0, 0, 8)

    tabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabList.CanvasSize = UDim2.new(0, 0, 0, tabListLayout.AbsoluteContentSize.Y + 10)
    end)

    local contentContainer = Create("Frame", {
        Name = "ContentContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -160, 1, -58),
        Position = UDim2.fromOffset(154, 52),
        ClipsDescendants = true,
        Parent = main
    })

    --------------------------------------------------------
    -- DRAGGING
    --------------------------------------------------------
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    --------------------------------------------------------
    -- CLOSE / MINIMIZE
    --------------------------------------------------------
    local minimized = false
    local originalSize = size

    closeBtn.MouseButton1Click:Connect(function()
        Tween(main, {
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1
        }, 0.35, Enum.EasingStyle.Quint)
        Tween(shadow, {ImageTransparency = 1}, 0.3)
        task.wait(0.38)
        screenGui:Destroy()
    end)

    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            Tween(main, {Size = UDim2.fromOffset(originalSize.X.Offset, 46)}, 0.35)
            contentContainer.Visible = false
            tabContainer.Visible = false
        else
            Tween(main, {Size = originalSize}, 0.4, Enum.EasingStyle.Quint)
            contentContainer.Visible = true
            tabContainer.Visible = true
        end
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == minimizeKey then
            minBtn.MouseButton1Click:Fire()
        end
    end)

    --------------------------------------------------------
    -- WINDOW OBJECT
    --------------------------------------------------------
    local windowObject = {
        ScreenGui = screenGui,
        Main = main,
        Tabs = {},
        CurrentTab = nil,
        Flags = {},
        Theme = Theme,
    }

    function windowObject:CreateTab(tabName)
        local tabButton = Create("TextButton", {
            Name = tabName,
            BackgroundColor3 = Theme.Tertiary,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 38),
            Font = Fonts.Main,
            Text = "  " .. tabName,
            TextColor3 = Theme.TextDim,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            Parent = tabList
        })
        AddCorner(tabButton, 8)

        local indicator = Create("Frame", {
            Name = "Indicator",
            BackgroundColor3 = Theme.Accent,
            Size = UDim2.fromOffset(3, 0),
            Position = UDim2.fromOffset(0, 19),
            BorderSizePixel = 0,
            Parent = tabButton
        })
        AddCorner(indicator, 2)

        local tabContent = Create("ScrollingFrame", {
            Name = tabName .. "_Content",
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.AccentDim,
            BorderSizePixel = 0,
            Visible = false,
            Parent = contentContainer
        })
        local contentLayout = AddListLayout(tabContent, 8)
        AddPadding(tabContent, 6, 10, 4, 12)

        contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContent.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 20)
        end)

        local tabData = {
            Button = tabButton,
            Content = tabContent,
            Name = tabName,
        }

        local function selectTab()
            for _, t in pairs(windowObject.Tabs) do
                t.Content.Visible = false
                Tween(t.Button, {BackgroundTransparency = 1, TextColor3 = Theme.TextDim}, 0.25)
                Tween(t.Button.Indicator, {Size = UDim2.fromOffset(3, 0), Position = UDim2.fromOffset(0, 19)}, 0.25)
            end
            tabContent.Visible = true
            Tween(tabButton, {BackgroundTransparency = 0.15, TextColor3 = Theme.Text}, 0.25)
            Tween(indicator, {Size = UDim2.fromOffset(3, 22), Position = UDim2.fromOffset(0, 8)}, 0.3, Enum.EasingStyle.Back)
            windowObject.CurrentTab = tabData
        end

        tabButton.MouseButton1Click:Connect(selectTab)
        tabButton.MouseEnter:Connect(function()
            if windowObject.CurrentTab ~= tabData then
                Tween(tabButton, {BackgroundTransparency = 0.4}, 0.2)
            end
        end)
        tabButton.MouseLeave:Connect(function()
            if windowObject.CurrentTab ~= tabData then
                Tween(tabButton, {BackgroundTransparency = 1}, 0.2)
            end
        end)

        if #windowObject.Tabs == 0 then
            task.defer(selectTab)
        end

        table.insert(windowObject.Tabs, tabData)

        -- ==================== ELEMENTS ====================

        function tabData:CreateSection(text)
            local section = Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 28),
                Parent = tabContent
            })
            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Font = Fonts.Bold,
                Text = text or "Section",
                TextColor3 = Theme.Text,
                TextSize = 15,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = section
            })
            return section
        end

        function tabData:CreateParagraph(options)
            options = options or {}
            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Parent = tabContent
            })
            AddCorner(frame, 8)
            AddPadding(frame, 12, 12, 10, 10)

            if options.Title then
                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 18),
                    Font = Fonts.Semi,
                    Text = options.Title,
                    TextColor3 = Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = frame
                })
            end

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Position = options.Title and UDim2.fromOffset(0, 22) or UDim2.fromOffset(0, 0),
                Font = Fonts.Main,
                Text = options.Content or "",
                TextColor3 = Theme.TextDim,
                TextSize = 13,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })
            return frame
        end

        function tabData:CreateButton(options)
            options = options or {}
            local name = options.Name or "Button"
            local callback = options.Callback or function() end

            local btn = Create("TextButton", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 40),
                Font = Fonts.Semi,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 14,
                AutoButtonColor = false,
                Parent = tabContent
            })
            AddCorner(btn, 8)
            AddStroke(btn, Theme.Stroke, 1, 0.5)

            btn.MouseEnter:Connect(function()
                Tween(btn, {BackgroundColor3 = Theme.Quaternary}, 0.2)
            end)
            btn.MouseLeave:Connect(function()
                Tween(btn, {BackgroundColor3 = Theme.Tertiary}, 0.2)
            end)
            btn.MouseButton1Click:Connect(function()
                Ripple(btn)
                callback()
            end)
            return btn
        end

        function tabData:CreateToggle(options)
            options = options or {}
            local name = options.Name or "Toggle"
            local default = options.Default or false
            local flag = options.Flag
            local callback = options.Callback or function() end

            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 44),
                Parent = tabContent
            })
            AddCorner(frame, 8)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -70, 1, 0),
                Position = UDim2.fromOffset(14, 0),
                Font = Fonts.Main,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })

            local toggleBg = Create("Frame", {
                BackgroundColor3 = default and Theme.Accent or Theme.Quaternary,
                Size = UDim2.fromOffset(42, 24),
                Position = UDim2.new(1, -56, 0.5, -12),
                Parent = frame
            })
            AddCorner(toggleBg, 12)

            local circle = Create("Frame", {
                BackgroundColor3 = Theme.Text,
                Size = UDim2.fromOffset(18, 18),
                Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.fromOffset(3, 3),
                Parent = toggleBg
            })
            AddCorner(circle, 9)

            local state = default
            if flag then windowObject.Flags[flag] = state end

            local function set(val, fire)
                state = val
                if flag then windowObject.Flags[flag] = state end
                Tween(toggleBg, {BackgroundColor3 = state and Theme.Accent or Theme.Quaternary}, 0.25)
                Tween(circle, {
                    Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.fromOffset(3, 3)
                }, 0.25, Enum.EasingStyle.Back)
                if fire ~= false then callback(state) end
            end

            local hit = Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Text = "",
                Parent = frame
            })
            hit.MouseButton1Click:Connect(function()
                set(not state)
            end)

            return {Set = set, Get = function() return state end}
        end

        function tabData:CreateSlider(options)
            options = options or {}
            local name = options.Name or "Slider"
            local min = options.Min or 0
            local max = options.Max or 100
            local default = options.Default or min
            local increment = options.Increment or 1
            local flag = options.Flag
            local callback = options.Callback or function() end

            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 62),
                Parent = tabContent
            })
            AddCorner(frame, 8)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -70, 0, 20),
                Position = UDim2.fromOffset(14, 8),
                Font = Fonts.Main,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })

            local valueLabel = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(60, 20),
                Position = UDim2.new(1, -70, 0, 8),
                Font = Fonts.Semi,
                Text = tostring(default),
                TextColor3 = Theme.Accent,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = frame
            })

            local barBg = Create("Frame", {
                BackgroundColor3 = Theme.Quaternary,
                Size = UDim2.new(1, -28, 0, 6),
                Position = UDim2.fromOffset(14, 40),
                Parent = frame
            })
            AddCorner(barBg, 3)

            local barFill = Create("Frame", {
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.fromScale((default - min) / math.max(max - min, 1), 1),
                BorderSizePixel = 0,
                Parent = barBg
            })
            AddCorner(barFill, 3)

            local knob = Create("Frame", {
                BackgroundColor3 = Theme.Text,
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new((default - min) / math.max(max - min, 1), -7, 0.5, -7),
                Parent = barBg
            })
            AddCorner(knob, 7)

            local value = default
            if flag then windowObject.Flags[flag] = value end

            local function set(val, fire)
                val = math.clamp(math.round(val / increment) * increment, min, max)
                value = val
                if flag then windowObject.Flags[flag] = value end
                local pct = (val - min) / math.max(max - min, 1)
                Tween(barFill, {Size = UDim2.fromScale(pct, 1)}, 0.15)
                Tween(knob, {Position = UDim2.new(pct, -7, 0.5, -7)}, 0.15)
                valueLabel.Text = tostring(val)
                if fire ~= false then callback(val) end
            end

            local sliding = false
            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                    set(min + (max - min) * rel)
                end
            end)

            return {Set = set, Get = function() return value end}
        end

        function tabData:CreateDropdown(options)
            options = options or {}
            local name = options.Name or "Dropdown"
            local items = options.Options or {"Option 1", "Option 2"}
            local default = options.Default or items[1]
            local flag = options.Flag
            local callback = options.Callback or function() end

            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 44),
                ClipsDescendants = true,
                Parent = tabContent
            })
            AddCorner(frame, 8)

            local label = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -40, 0, 44),
                Position = UDim2.fromOffset(14, 0),
                Font = Fonts.Main,
                Text = name .. ": " .. tostring(default),
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })

            local arrow = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(30, 44),
                Position = UDim2.new(1, -34, 0, 0),
                Font = Fonts.Bold,
                Text = "▾",
                TextColor3 = Theme.TextDim,
                TextSize = 16,
                Parent = frame
            })

            local dropFrame = Create("Frame", {
                BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.fromOffset(0, 44),
                ClipsDescendants = true,
                Parent = frame
            })
            AddCorner(dropFrame, 8)
            AddListLayout(dropFrame, 2)
            AddPadding(dropFrame, 6, 6, 6, 6)

            local open = false
            local current = default
            if flag then windowObject.Flags[flag] = current end

            local function toggle()
                open = not open
                local height = open and math.min(#items * 32 + 12, 180) or 0
                Tween(frame, {Size = UDim2.new(1, 0, 0, 44 + height)}, 0.3, Enum.EasingStyle.Quint)
                Tween(dropFrame, {Size = UDim2.new(1, 0, 0, height)}, 0.3, Enum.EasingStyle.Quint)
                Tween(arrow, {Rotation = open and 180 or 0}, 0.3)
            end

            local hit = Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 44),
                Text = "",
                Parent = frame
            })
            hit.MouseButton1Click:Connect(toggle)

            for _, item in ipairs(items) do
                local opt = Create("TextButton", {
                    BackgroundColor3 = Theme.Tertiary,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 30),
                    Font = Fonts.Main,
                    Text = "  " .. item,
                    TextColor3 = Theme.TextDim,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = dropFrame
                })
                AddCorner(opt, 6)
                opt.MouseEnter:Connect(function()
                    Tween(opt, {BackgroundTransparency = 0.3, TextColor3 = Theme.Text}, 0.15)
                end)
                opt.MouseLeave:Connect(function()
                    Tween(opt, {BackgroundTransparency = 1, TextColor3 = Theme.TextDim}, 0.15)
                end)
                opt.MouseButton1Click:Connect(function()
                    current = item
                    if flag then windowObject.Flags[flag] = current end
                    label.Text = name .. ": " .. item
                    toggle()
                    callback(item)
                end)
            end

            return {
                Set = function(val)
                    current = val
                    label.Text = name .. ": " .. val
                    if flag then windowObject.Flags[flag] = current end
                end,
                Get = function() return current end
            }
        end

        function tabData:CreateKeybind(options)
            options = options or {}
            local name = options.Name or "Keybind"
            local default = options.Default or Enum.KeyCode.E
            local flag = options.Flag
            local callback = options.Callback or function() end

            local frame = Create("Frame", {
                BackgroundColor3 = Theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 44),
                Parent = tabContent
            })
            AddCorner(frame, 8)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -110, 1, 0),
                Position = UDim2.fromOffset(14, 0),
                Font = Fonts.Main,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = frame
            })

            local keyBtn = Create("TextButton", {
                BackgroundColor3 = Theme.Quaternary,
                Size = UDim2.fromOffset(90, 28),
                Position = UDim2.new(1, -104, 0.5, -14),
                Font = Fonts.Semi,
                Text = default.Name,
                TextColor3 = Theme.Text,
                TextSize = 13,
                AutoButtonColor = false,
                Parent = frame
            })
            AddCorner(keyBtn, 6)

            local current = default
            local listening = false
            if flag then windowObject.Flags[flag] = current end

            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
                Tween(keyBtn, {BackgroundColor3 = Theme.Accent}, 0.2)
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    current = input.KeyCode
                    if flag then windowObject.Flags[flag] = current end
                    keyBtn.Text = current.Name
                    listening = false
                    Tween(keyBtn, {BackgroundColor3 = Theme.Quaternary}, 0.2)
                    callback(current)
                end
            end)

            return {
                Set = function(k)
                    current = k
                    keyBtn.Text = k.Name
                    if flag then windowObject.Flags[flag] = current end
                end,
                Get = function() return current end
            }
        end

