-- Export Nametag String Code (Compact JSON Base64)
function Velox:ExportNametagCode(config)
    local raw = HttpService:JSONEncode({
        Title = config.Title or "USER",
        Subtitle = config.Subtitle or "VIP",
        ColorR = math.round((config.Color or Color3.new(1, 1, 1)).R * 255),
        ColorG = math.round((config.Color or Color3.new(1, 1, 1)).G * 255),
        ColorB = math.round((config.Color or Color3.new(1, 1, 1)).B * 255),
        Icon = config.Icon or "",
        Animation = config.Animation or "None",
        BgImage = config.BgImage or "",
    })
    local encoded = ""
    local ok, res = pcall(function()
        if syn and syn.crypt then
            return syn.crypt.base64.encode(raw)
        end
        return raw -- fallback
    end)
    return "TAG-" .. (ok and res or raw)
end

-- Decode Nametag String Code
function Velox:DecodeNametagCode(code)
    if not code or type(code) ~= "string" then return nil end
    local payload = code:gsub("^TAG%-", "")
    local ok, decoded = pcall(function()
        if syn and syn.crypt then
            return syn.crypt.base64.decode(payload)
        end
        return payload
    end)
    local succ, data = pcall(function() return HttpService:JSONDecode(ok and decoded or payload) end)
    if succ and data then
        return {
            Title = data.Title,
            Subtitle = data.Subtitle,
            Color = Color3.fromRGB(data.ColorR or 90, data.ColorG or 140, data.ColorB or 255),
            Icon = data.Icon,
            Animation = data.Animation,
            BgImage = data.BgImage,
        }
    end
    return nil
end

-- P2P Mesh & Cloud Sync Listener (Zero-cost across all script users)
function Velox:InitializeNametagSync(cloudUrl)
    -- 1. In-game Character Attribute Mesh Sync (100% Free, Native)
    local function syncPlayer(plr)
        local function checkAttr(char)
            if not char then return end
            char:GetAttributeChangedSignal("VeloxCustomTag"):Connect(function()
                local tagCode = char:GetAttribute("VeloxCustomTag")
                if tagCode then
                    local cfg = Velox:DecodeNametagCode(tagCode)
                    if cfg then Velox:ApplyNametagToPlayer(plr, cfg) end
                end
            end)
            local existing = char:GetAttribute("VeloxCustomTag")
            if existing then
                local cfg = Velox:DecodeNametagCode(existing)
                if cfg then Velox:ApplyNametagToPlayer(plr, cfg) end
            end
        end
        if plr.Character then checkAttr(plr.Character) end
        plr.CharacterAdded:Connect(checkAttr)
    end

    for _, p in ipairs(Players:GetPlayers()) do syncPlayer(p) end
    Players.PlayerAdded:Connect(syncPlayer)

    -- 2. Optional Free GitHub Gist / JSON sync (Unlimited free requests)
    if cloudUrl and cloudUrl ~= "" then
        task.spawn(function()
            local succ, content = pcall(function() return game:HttpGet(cloudUrl) end)
            if succ and content then
                local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
                if ok and data then
                    for userIdStr, tagCode in pairs(data) do
                        local uid = tonumber(userIdStr)
                        local targetPlr = Players:GetPlayerByUserId(uid)
                        if targetPlr then
                            local cfg = Velox:DecodeNametagCode(tagCode)
                            if cfg then Velox:ApplyNametagToPlayer(targetPlr, cfg) end
                        end
                    end
                end
            end
        end)
    end
end

