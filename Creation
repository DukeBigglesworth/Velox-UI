-- Allows developers to easily assemble completely custom freehand UIs
-- while keeping the signature Velox Obsidian styling, lit strokes & sounds!
function Velox.createUI(width, height, position, title, themeKey)
    local theme = Velox.Themes[themeKey or "Obsidian"] or Velox.Themes.Obsidian
    local w = width or 400
    local h = height or 300
    local pos = position or UDim2.fromScale(0.5, 0.5)

    local gui = Create("ScreenGui", {
        Name = "Velox_Custom_" .. HttpService:GenerateGUID(false):sub(1, 8),
        ResetOnSpawn = false,
        DisplayOrder = 50,
        Parent = GuiParent
    })

    local frame = Create("Frame", {
        Name = "VeloxCustomFrame",
        BackgroundColor3 = theme.Background,
        Size = UDim2.fromOffset(w, h),
        Position = pos,
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = false,
        Parent = gui
    })
    corner(frame, 12)
    AddLitStroke(frame, theme, 1, 0.5)

    -- Ambient Glow Shadow
    Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = theme.Shadow,
        ImageTransparency = 0.35,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, 60, 1, 60),
        Position = UDim2.fromOffset(-30, -30),
        ZIndex = 0,
        Parent = frame
    })

    -- Draggable titlebar
    local titleBar = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, 38),
        Parent = frame
    })
    corner(titleBar, 12)
    Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.fromOffset(0, 26),
        Parent = titleBar
    })
    MakeDraggable(titleBar, frame)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Font = Fonts.Bold,
        Text = title or "Custom Velox UI",
        TextColor3 = theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar
    })

    local closeB = Create("TextButton", {
        BackgroundColor3 = theme.Tertiary,
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(1, -30, 0.5, -12),
        Font = Fonts.Bold,
        Text = "×",
        TextColor3 = theme.TextDim,
        TextSize = 16,
        AutoButtonColor = false,
        Parent = titleBar
    })
    corner(closeB, 6)
    AddBouncyClick(closeB, function()
        frame.Visible = false
    end)

    local container = Create("Frame", {
        Name = "Container",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -50),
        Position = UDim2.fromOffset(10, 44),
        ClipsDescendants = true,
        Parent = frame
    })

    local customUI = {
        Gui = gui,
        Frame = frame,
        Container = container,
        Theme = theme
    }

    -- Easy Component Methods on customUI
    function customUI:AddButton(opts)
        opts = opts or {}
        local btn = Create("TextButton", {
            BackgroundColor3 = theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 36),
            Position = opts.Position or UDim2.new(0, 0, 0, 0),
            Font = Fonts.Semi,
            Text = opts.Text or "Button",
