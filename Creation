            BackgroundColor3 = opts.Color or theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 60),
            Position = opts.Position or UDim2.new(0, 0, 0, 0),
            Parent = opts.Parent or container
        })
