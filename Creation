        settingsModal.Visible = not settingsModal.Visible
        if settingsModal.Visible then
            Tween(gearIcon, {Rotation = gearIcon.Rotation + 90}, 0.3)
            settingsModal.Position = UDim2.new(1, -10, 0, 0)
            Tween(settingsModal, {Position = UDim2.new(1, 10, 0, 0)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        end
    end)

    -- Smooth Minimize & Close
    local minimized = false
    local origSize = size
    AddBouncyClick(minBtn, function()
        minimized = not minimized
        if minimized then
            bodyWrapper.Visible = false
            headerBottomPatch.Visible = false
            settingsModal.Visible = false
            minBtn.Text = "+"
            Tween(main, {Size = UDim2.fromOffset(origSize.X.Offset, 54)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        else
            minBtn.Text = "–"
            local t = Tween(main, {Size = origSize}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            t.Completed:Connect(function()
                if not minimized then
                    bodyWrapper.Visible = true
                    headerBottomPatch.Visible = true
                end
            end)
        end
    end)

    -- Pop-out Clean Close
    AddBouncyClick(closeBtn, function()
        playSound(Velox.Sounds.Click, 0.4)
        bodyWrapper.Visible = false
        headerBottomPatch.Visible = false
        settingsModal.Visible = false
        Tween(mainScale, {Scale = 0.72}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        Tween(main, {BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart)
        Tween(header, {BackgroundTransparency = 1}, 0.22, Enum.EasingStyle.Quart)
        task.wait(0.24)
        main.Visible = false
        -- Don't destroy if mobile toggle is active, so mobile users can reopen!
        if not showMobileToggle then
            gui:Destroy()
        end
    end)

    -- Keyboard Keybind
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if not gpe and inp.KeyCode == minKey then
            main.Visible = not main.Visible
            playSound(Velox.Sounds.Click, 0.3)
        end
    end)

    -- Mobile floating pill toggle so mobile users can always reopen/unminimize!
    if showMobileToggle then
        Velox:CreateMobileToggle(function()
            main.Visible = not main.Visible
            if main.Visible then
                bodyWrapper.Visible = not minimized
                headerBottomPatch.Visible = not minimized
                main.BackgroundTransparency = 0
                header.BackgroundTransparency = 0
                mainScale.Scale = 0.85
                Tween(mainScale, {Scale = 1.0}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end)
    end

    --------------------------------------------------------
    -- WINDOW OBJECT API
    --------------------------------------------------------
    local win = {
        ScreenGui = gui,
        Main = main,
        Tabs = {},
