                    local itmBtn = Create("TextButton", {
                        BackgroundColor3 = theme.Tertiary,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 26),
                        Font = Fonts.Main,
                        Text = "  " .. tostring(item),
                        TextColor3 = theme.TextDim,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false,
                        ZIndex = 32,
                        Parent = dropScroll
                    })
                    corner(itmBtn, 5)

                    if not isMulti and item == selected then
                        itmBtn.TextColor3 = accentColor
                        itmBtn.BackgroundTransparency = 0.5
                    elseif isMulti and selected[item] then
                        itmBtn.TextColor3 = accentColor
                        itmBtn.BackgroundTransparency = 0.5
                    end

                    AddBouncyClick(itmBtn, function()
                        if isMulti then
                            selected[item] = not selected[item]
                            local selList = {}
                            for k, v in pairs(selected) do if v then table.insert(selList, k) end end
                            displayLabel.Text = #selList > 0 and table.concat(selList, ", ") or "Select items..."
                            if cb then cb(selected) end
                        else
                            selected = item
                            displayLabel.Text = tostring(item)
                            dropList.Visible = false
                            dropIcon.Text = "▼"
                            if cb then cb(item) end
                        end
                        renderDropdownItems()
                    end)
                end
            end

            AddBouncyClick(trigger, function()
                isOpen = not isOpen
                dropList.Visible = isOpen
                dropIcon.Text = isOpen and "▲" or "▼"
                if isOpen then renderDropdownItems() end
            end)

            table.insert(tabData.Elements, {Name = dName, Frame = card})
            return {
                Set = function(val)
                    selected = val
                    displayLabel.Text = tostring(val)
                    if cb then cb(val) end
                end,
                Refresh = function(newItems)
                    items = newItems or {}
                    dropList.Size = UDim2.new(1, 0, 0, math.min(#items * 28 + 6, 140))
                    dropScroll.CanvasSize = UDim2.new(0, 0, 0, #items * 28 + 6)
                    renderDropdownItems()
                end,
                Value = function() return selected end
            }
        end

        function tabData:CreateKeybind(opts)
            opts = opts or {}
            local kName = opts.Name or "Keybind"
            local currentKey = opts.Default or Enum.KeyCode.F
            local cb = opts.Callback
            local listening = false

            local card = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, -6, 0, 38),
                Parent = tabContainer
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.75)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 160, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                Font = Fonts.Semi,
                Text = kName,
                TextColor3 = theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local keyBtn = Create("TextButton", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.fromOffset(70, 24),
                Position = UDim2.new(1, -82, 0.5, -12),
                Font = Fonts.Bold,
                Text = currentKey.Name,
                TextColor3 = accentColor,
                TextSize = 11,
                AutoButtonColor = false,
                Parent = card
            })
            corner(keyBtn, 6)
            AddLitStroke(keyBtn, theme, 1, 0.6)
            table.insert(accentSubscribers, function(c) keyBtn.TextColor3 = c end)

            AddBouncyClick(keyBtn, function()
                listening = true
                keyBtn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(inp, gpe)
                if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = inp.KeyCode
                    listening = false
                    keyBtn.Text = currentKey.Name
                    playSound(Velox.Sounds.Click, 0.3)
                    if cb then cb(currentKey) end
                elseif not gpe and not listening and inp.KeyCode == currentKey then
                    if cb then cb(currentKey) end
                end
            end)

            table.insert(tabData.Elements, {Name = kName, Frame = card})
            return {
                Set = function(newKey)
                    currentKey = newKey
                    keyBtn.Text = newKey.Name
                end,
                Value = function() return currentKey end
            }
        end

        return tabData
    end

    -- Run Forced Background-Free Materialize Reveal
    task.spawn(function()
        Velox:PlayLoadingScreen(theme, function()
            main.Visible = true
            mainScale.Scale = 0.85
            Tween(mainScale, {Scale = 1.0}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
    end)

    return win
end

----------------------------------------------------------------
-- 7. FREEHAND CUSTOM UI BUILDER API (Velox.createUI)
----------------------------------------------------------------
function Velox.createUI(width, height, position, title, themeKey)
    local theme = Velox.Themes[themeKey or "Obsidian"] or Velox.Themes.Obsidian
    local w = width or 400
    local h = height or 300
    local pos = position or UDim2.fromScale(0.5, 0.5)

    local gui = Create("ScreenGui", {
        Name = "Velox_Custom_" .. HttpService:GenerateGUID(false):sub(1, 8),
        ResetOnSpawn = false,
        DisplayOrder = 50,
        Parent = GuiParent
    })

    local frame = Create("Frame", {
        Name = "VeloxCustomFrame",
        BackgroundColor3 = theme.Background,
        Size = UDim2.fromOffset(w, h),
        Position = pos,
        AnchorPoint = Vector2.new(0.5, 0.5),
        ClipsDescendants = false,
        Parent = gui
    })
    corner(frame, 12)
    AddLitStroke(frame, theme, 1, 0.5)

    Create("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = theme.Shadow,
        ImageTransparency = 0.35,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, 60, 1, 60),
        Position = UDim2.fromOffset(-30, -30),
        ZIndex = 0,
        Parent = frame
    })

    local titleBar = Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        Size = UDim2.new(1, 0, 0, 38),
        Parent = frame
    })
    corner(titleBar, 12)
    Create("Frame", {
        BackgroundColor3 = theme.Secondary,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.fromOffset(0, 26),
        Parent = titleBar
    })
    MakeDraggable(titleBar, frame)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Font = Fonts.Bold,
        Text = title or "Custom Velox UI",
        TextColor3 = theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar
    })

    local closeB = Create("TextButton", {
        BackgroundColor3 = theme.Tertiary,
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(1, -30, 0.5, -12),
        Font = Fonts.Bold,
        Text = "×",
        TextColor3 = theme.TextDim,
        TextSize = 16,
        AutoButtonColor = false,
        Parent = titleBar
    })
    corner(closeB, 6)
    AddBouncyClick(closeB, function() frame.Visible = false end)

    local container = Create("Frame", {
        Name = "Container",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -50),
        Position = UDim2.fromOffset(10, 44),
        ClipsDescendants = true,
        Parent = frame
    })

    local customUI = {
        Gui = gui,
        Frame = frame,
        Container = container,
        Theme = theme
    }

    function customUI:AddButton(opts)
        opts = opts or {}
        local btn = Create("TextButton", {
            BackgroundColor3 = theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 36),
            Position = opts.Position or UDim2.new(0, 0, 0, 0),
            Font = Fonts.Semi,
            Text = opts.Text or "Button",
            TextColor3 = theme.Text,
            TextSize = 12,
            AutoButtonColor = false,
            Parent = opts.Parent or container
        })
        corner(btn, 8)
        AddLitStroke(btn, theme, 1, 0.7)
        AddBouncyClick(btn, opts.Callback)
        return btn
    end

    function customUI:AddCard(opts)
        opts = opts or {}
        local card = Create("Frame", {
            BackgroundColor3 = opts.Color or theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 60),
            Position = opts.Position or UDim2.new(0, 0, 0, 0),
            Parent = opts.Parent or container
        })
        corner(card, opts.Radius or 8)
        AddLitStroke(card, theme, 1, 0.7)
        return card
    end

    function customUI:AddToggle(opts)
        opts = opts or {}
        local state = opts.Default or false
        local card = Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            Size = opts.Size or UDim2.new(1, 0, 0, 36),
            Position = opts.Position or UDim2.new(0, 0, 0, 0),
            Parent = opts.Parent or container
        })
        corner(card, 8)
        AddLitStroke(card, theme, 1, 0.7)

        Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -55, 1, 0),
            Position = UDim2.fromOffset(10, 0),
            Font = Fonts.Semi,
            Text = opts.Text or "Toggle",
            TextColor3 = theme.Text,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        local sw = Create("TextButton", {
            BackgroundColor3 = state and theme.Accent or theme.Tertiary,
            Size = UDim2.fromOffset(36, 18),
            Position = UDim2.new(1, -44, 0.5, -9),
            Text = "",
            AutoButtonColor = false,
            Parent = card
        })
        corner(sw, 9)
        local d = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size = UDim2.fromOffset(12, 12),
            Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
            Parent = sw
        })
        corner(d, 6)

        AddBouncyClick(sw, function()
            state = not state
            playSound(Velox.Sounds.Toggle, 0.28)
            if state then
                Tween(sw, {BackgroundColor3 = theme.Accent}, 0.2)
                Tween(d, {Position = UDim2.fromOffset(21, 3)}, 0.2)
            else
                Tween(sw, {BackgroundColor3 = theme.Tertiary}, 0.2)
                Tween(d, {Position = UDim2.fromOffset(3, 3)}, 0.2)
            end
            if opts.Callback then opts.Callback(state) end
        end)

        return card
    end

    return customUI
end

