function Velox:HasRole(player, reqRole)
    local curRole = self.ActiveRole or "Free"
    local curP = (self.Roles[curRole] and self.Roles[curRole].Priority) or 0
    local reqP = (self.Roles[reqRole] and self.Roles[reqRole].Priority) or 0
    return curP >= reqP
end

function Velox:ExportNametagCode(config)
    local serialized = {
        T = config.Title or "VIP",
        S = config.Subtitle or "Verified",
        C = config.Color and {math.floor(config.Color.R * 255), math.floor(config.Color.G * 255), math.floor(config.Color.B * 255)} or {90, 140, 255},
        I = config.Icon or "",
        A = config.Animation or "None",
        B = config.BgImage or "",
        R = self.ActiveRole or "Free",
        H = config.Height or 2.3,
        U = LocalPlayer.UserId,
        V = 2
    }
    local jsonStr = HttpService:JSONEncode(serialized)
    local b64 = nil
    pcall(function()
        if syn and syn.crypt and syn.crypt.base64 then
            b64 = syn.crypt.base64.encode(jsonStr)
        elseif crypt and crypt.base64decode then
            b64 = crypt.base64encode(jsonStr)
        end
    end)
    if not b64 then
        b64 = ""
        for i = 1, #jsonStr do
            b64 = b64 .. string.format("%02X", string.byte(jsonStr, i))
        end
    end
    return "VELOX-TAG-" .. b64
end

function Velox:DecodeNametagCode(code)
    if not code or not code:find("^VELOX%-TAG%-") then return nil end
    local payload = code:gsub("^VELOX%-TAG%-", "")
    local jsonStr = nil
    pcall(function()
        if syn and syn.crypt and syn.crypt.base64 then
            jsonStr = syn.crypt.base64.decode(payload)
        elseif crypt and crypt.base64decode then
            jsonStr = crypt.base64decode(payload)
        end
    end)
    if not jsonStr then
        pcall(function()
            local str = ""
            for hex in payload:gmatch("..") do
                str = str .. string.char(tonumber(hex, 16))
            end
            jsonStr = str
        end)
    end
    if not jsonStr then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(jsonStr) end)
    if ok and data then
        return {
            Title = data.T,
            Subtitle = data.S,
            Color = data.C and Color3.fromRGB(data.C[1], data.C[2], data.C[3]) or Color3.fromRGB(90, 140, 255),
            Icon = data.I,
            Animation = data.A,
            BgImage = data.B,
            Role = data.R,
            Height = data.H or 2.3,
            UserId = data.U
        }
    end
    return nil
end

