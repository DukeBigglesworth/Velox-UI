                BackgroundColor3 = theme.Text,
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new((def - min) / math.max(max - min, 1), -7, 0.5, -7),
                Parent = track
            })
            corner(thumb, 7)

            local value = def
            if flag then win.Flags[flag] = value end

            local function set(val, fire)
                val = math.clamp(math.round(val), min, max)
                value = val
                if flag then win.Flags[flag] = value end
                local pct = (val - min) / math.max(max - min, 1)
                Tween(fill, {Size = UDim2.fromScale(pct, 1)}, 0.1)
                Tween(thumb, {Position = UDim2.new(pct, -7, 0.5, -7)}, 0.1)
                valBox.Text = tostring(val) .. suffix
                if fire ~= false then cb(val) end
            end

            valBox.FocusLost:Connect(function()
                local parsed = tonumber(valBox.Text:gsub("%D+", ""))
                if parsed then set(parsed) else set(value) end
            end)

            local sliding = false
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    set(min + (max - min) * rel)
                end
            end)

            return {Set = set, Get = function() return value end}
        end

        -- Dropdown
        function tabData:CreateDropdown(opts)
            opts = opts or {}
            local name = opts.Name or "Dropdown"
            local items = opts.Options or {"Option 1", "Option 2"}
            local def = opts.Default or items[1]
            local flag = opts.Flag
            local cb = opts.Callback or function() end

            local card = Create("Frame", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 42),
                ClipsDescendants = true,
                Parent = page
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.7)
            card:SetAttribute("SearchText", name:lower())

            local label = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -40, 0, 42),
                Position = UDim2.fromOffset(14, 0),
                Font = Fonts.Semi,
                Text = name .. ":  " .. tostring(def),
                TextColor3 = theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local arrow = Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(30, 42),
                Position = UDim2.new(1, -34, 0, 0),
                Font = Fonts.Bold,
                Text = "▾",
                TextColor3 = theme.TextDim,
                TextSize = 16,
                Parent = card
            })

            local dropFrame = Create("Frame", {
                BackgroundColor3 = theme.Secondary,
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.fromOffset(0, 42),
                ClipsDescendants = true,
                Parent = card
            })
            corner(dropFrame, 8)
            list(dropFrame, 2)
            pad(dropFrame, 6, 6, 6, 6)

            local open = false
            local current = def
            if flag then win.Flags[flag] = current end

            local function toggle()
                open = not open
                local height = open and math.min(#items * 30 + 12, 160) or 0
                Tween(card, {Size = UDim2.new(1, 0, 0, 42 + height)}, 0.3, Enum.EasingStyle.Quart)
                Tween(dropFrame, {Size = UDim2.new(1, 0, 0, height)}, 0.3, Enum.EasingStyle.Quart)
                Tween(arrow, {Rotation = open and 180 or 0}, 0.25)
                playSound(Velox.Sounds.Click, 0.25)
            end

            local hit = Create("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 42),
                Text = "",
                Parent = card
            })
            hit.MouseButton1Click:Connect(toggle)

            for _, item in ipairs(items) do
                local opt = Create("TextButton", {
                    BackgroundColor3 = theme.Tertiary,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 28),
                    Font = Fonts.Main,
                    Text = "  " .. item,
                    TextColor3 = theme.TextDim,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = dropFrame
                })
                corner(opt, 6)
                opt.MouseButton1Click:Connect(function()
                    current = item
                    if flag then win.Flags[flag] = current end
                    label.Text = name .. ":  " .. item
                    toggle()
                    cb(item)
                end)
            end

            return {
                Set = function(val)
                    current = val
                    label.Text = name .. ":  " .. val
                    if flag then win.Flags[flag] = current end
                end,
                Get = function() return current end
            }
        end

        -- Keybind
        function tabData:CreateKeybind(opts)
            opts = opts or {}
            local name = opts.Name or "Keybind"
            local def = opts.Default or Enum.KeyCode.E
            local flag = opts.Flag
            local cb = opts.Callback or function() end

            local card = Create("Frame", {
                BackgroundColor3 = theme.Tertiary,
                Size = UDim2.new(1, 0, 0, 42),
                Parent = page
            })
            corner(card, 8)
            AddLitStroke(card, theme, 1, 0.7)
            card:SetAttribute("SearchText", name:lower())

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -110, 1, 0),
                Position = UDim2.fromOffset(14, 0),
                Font = Fonts.Semi,
                Text = name,
                TextColor3 = theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card
            })

            local keyBtn = Create("TextButton", {
                BackgroundColor3 = theme.InputBackground,
                Size = UDim2.fromOffset(80, 26),
                Position = UDim2.new(1, -94, 0.5, -13),
                Font = Fonts.Bold,
                Text = def.Name,
                TextColor3 = accentColor,
                TextSize = 12,
                AutoButtonColor = false,
                Parent = card
            })
            corner(keyBtn, 6)
            table.insert(accentSubscribers, function(col)
                Tween(keyBtn, {TextColor3 = col}, 0.25)
            end)

            local current = def
            local listening = false
            if flag then win.Flags[flag] = current end

            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
                Tween(keyBtn, {BackgroundColor3 = accentColor, TextColor3 = theme.Text}, 0.2)
                playSound(Velox.Sounds.Click, 0.3)
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    current = input.KeyCode
                    if flag then win.Flags[flag] = current end
                    keyBtn.Text = current.Name
                    listening = false
                    Tween(keyBtn, {BackgroundColor3 = theme.InputBackground, TextColor3 = accentColor}, 0.2)
                    cb(current)
                end
            end)

            return {
                Set = function(k)
                    current = k
                    keyBtn.Text = k.Name
                    if flag then win.Flags[flag] = current end
                end,
                Get = function() return current end
            }
        end

        return tabData
    end

    return win
end

return Velox
