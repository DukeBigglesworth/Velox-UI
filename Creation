local function ensureNotifs()
    if notifHolder and notifHolder.Parent then return end
    local notifGui = Create("ScreenGui", {
        Name = "Velox_Notifications",
        DisplayOrder = 9999,
        ResetOnSpawn = false,
        Parent = GuiParent
    })
    notifHolder = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 310, 1, -40),
        Position = UDim2.new(1, -330, 0, 20),
        Parent = notifGui
    })
    list(notifHolder, 10, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
end

function Velox:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local notifType = opts.Type or "Info"
    local duration = opts.Duration or 3.5

    ensureNotifs()
    playSound(self.Sounds.Notify, 0.35)

    local colors = {
        Success = self.Themes.Obsidian.Success,
        Error   = self.Themes.Obsidian.Error,
        Warning = self.Themes.Obsidian.Warning,
        Info    = self.Themes.Obsidian.Info,
    }
    local typeColor = colors[notifType] or colors.Info

    local notif = Create("Frame", {
        BackgroundColor3 = self.Themes.Obsidian.Secondary,
        Size = UDim2.fromOffset(300, 72),
        ClipsDescendants = true,
        Parent = notifHolder
    })
    corner(notif, 10)
    AddLitStroke(notif, {BorderLight = Color3.fromRGB(255, 255, 255), Accent = typeColor, BorderDark = Color3.fromRGB(35, 38, 48)}, 1, 0.5)

    local strip = Create("Frame", {
        BackgroundColor3 = typeColor,
        Size = UDim2.new(0, 4, 1, 0),
        BorderSizePixel = 0,
        Parent = notif
    })
    corner(strip, 2)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.fromOffset(16, 10),
        Font = Fonts.Bold,
        Text = title,
        TextColor3 = self.Themes.Obsidian.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -24, 0, 32),
        Position = UDim2.fromOffset(16, 28),
        Font = Fonts.Main,
        Text = content,
        TextColor3 = self.Themes.Obsidian.TextDim,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif
    })

    local timerBar = Create("Frame", {
        BackgroundColor3 = typeColor,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BorderSizePixel = 0,
        Parent = notif
    })
    Tween(timerBar, {Size = UDim2.new(0, 0, 0, 2)}, duration, Enum.EasingStyle.Linear)

    local nScale = Create("UIScale", {Scale = 0.8, Parent = notif})
    Tween(nScale, {Scale = 1.0}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        Tween(nScale, {Scale = 0.8}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(notif, {BackgroundTransparency = 1}, 0.2)
        task.wait(0.22)
        if notif and notif.Parent then notif:Destroy() end
    end)
end

