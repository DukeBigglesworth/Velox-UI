        Parent = loaderGui
    })
    corner(heroBox, 16)
    local heroStroke = AddLitStroke(heroBox, theme, 1.2, 1)
    local heroScale = Create("UIScale", {Scale = 0.85, Parent = heroBox})

    -- Letters Container
    local lettersHolder = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 64),
        Position = UDim2.fromOffset(0, 32),
        Parent = heroBox
    })
    list(lettersHolder, 14, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

    -- Underline glowing bar
    local underlineBar = Create("Frame", {
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(0, 2),
        Position = UDim2.new(0.5, 0, 0, 110),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        Parent = heroBox
    })
    corner(underlineBar, 1)

    -- "library by Schwein" Badge Frame
    local creditBadge = Create("Frame", {
        BackgroundColor3 = theme.Tertiary,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(210, 28),
        Position = UDim2.new(0.5, 0, 0, 126),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = heroBox
    })
    corner(creditBadge, 14)
    local badgeStroke = AddLitStroke(creditBadge, theme, 1, 1)

    local creditLabel = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Fonts.Bold,
        Text = "library by Schwein",
        TextColor3 = Color3.fromRGB(240, 245, 255),
        TextSize = 13,
        TextTransparency = 1,
        Parent = creditBadge
    })

    -- Stage 1: Intro Fade-in (0.45s)
    Tween(backdrop, {BackgroundTransparency = 0.22}, 0.45)
    Tween(ambientGlow, {ImageTransparency = 0.6}, 0.5)
    Tween(heroBox, {BackgroundTransparency = 0.08}, 0.45)
    Tween(heroStroke, {Transparency = 0.35}, 0.45)
    Tween(heroScale, {Scale = 1.0}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.wait(0.35)

    -- Stage 2: Create Letters
    local letters = {"V", "E", "L", "O", "X"}
    local letterObjs = {}

    for _, char in ipairs(letters) do
        local lFrame = Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(46, 58),
            Parent = lettersHolder
        })
        local lScale = Create("UIScale", {Scale = 0.15, Parent = lFrame})

        local lGlow = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Fonts.Black,
            Text = char,
            TextColor3 = theme.Accent,
            TextSize = 48,
            TextTransparency = 1,
            Parent = lFrame
        })

        local lText = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Fonts.Black,
            Text = char,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 48,
            TextTransparency = 1,
            Position = UDim2.fromOffset(0, -30),
            Parent = lFrame
        })

        table.insert(letterObjs, {Frame = lFrame, Glow = lGlow, Text = lText, Scale = lScale})
    end

    -- Stage 3: Deliberate Letter-by-Letter Reveal with Audio (5 * 0.22s = ~1.1s)
    for i, data in ipairs(letterObjs) do
        playSound(Velox.Sounds.Chime, 0.45, 0.85 + (i * 0.1))
        Tween(data.Text, {Position = UDim2.fromOffset(0, 0), TextTransparency = 0}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        Tween(data.Glow, {TextTransparency = 0.45}, 0.3)
        Tween(data.Scale, {Scale = 1.0}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        task.wait(0.22)
    end

    -- Stage 4: Underline bar expands across (0.4s)
    Tween(underlineBar, {Size = UDim2.fromOffset(260, 2), BackgroundTransparency = 0}, 0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    task.wait(0.25)

    -- Stage 5: "library by Schwein" reveal with triumphant chime (0.4s)
    playSound(Velox.Sounds.Success, 0.42, 1.1)
    Tween(creditBadge, {BackgroundTransparency = 0.25}, 0.35)
    Tween(badgeStroke, {Transparency = 0.45}, 0.35)
    Tween(creditLabel, {TextTransparency = 0}, 0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    -- Stage 6: Showcase Hold - full 1.5 seconds of admiring the complete branding!
    task.wait(1.5)

    -- Stage 7: Smooth Outro Dissolve with futuristic sweep (0.4s)
    playSound(Velox.Sounds.Sweep, 0.35, 1.15)
    Tween(heroScale, {Scale = 1.08}, 0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    Tween(heroBox, {BackgroundTransparency = 1}, 0.35)
    Tween(heroStroke, {Transparency = 1}, 0.35)
    Tween(underlineBar, {BackgroundTransparency = 1}, 0.3)
    Tween(creditBadge, {BackgroundTransparency = 1}, 0.3)
    Tween(badgeStroke, {Transparency = 1}, 0.3)
    Tween(creditLabel, {TextTransparency = 1}, 0.3)
    for _, data in ipairs(letterObjs) do
        Tween(data.Text, {TextTransparency = 1}, 0.3)
        Tween(data.Glow, {TextTransparency = 1}, 0.3)
    end
    Tween(backdrop, {BackgroundTransparency = 1}, 0.38)
    Tween(ambientGlow, {ImageTransparency = 1}, 0.38)

    task.wait(0.42)
    loaderGui:Destroy()

    if onComplete then
        onComplete()
    end
end

