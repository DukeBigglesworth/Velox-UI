        BackgroundColor3 = Velox.Sounds.Enabled and accentColor or theme.Quaternary,
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 52,
        Parent = sfxBox
    })
    corner(sfxToggleBtn, 10)
    local sfxDot = Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.fromOffset(14, 14),
        Position = Velox.Sounds.Enabled and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
        ZIndex = 53,
        Parent = sfxToggleBtn
    })
    corner(sfxDot, 7)
    AddBouncyClick(sfxToggleBtn, function()
        Velox.Sounds.Enabled = not Velox.Sounds.Enabled
        if Velox.Sounds.Enabled then
            Tween(sfxToggleBtn, {BackgroundColor3 = accentColor}, 0.2)
            Tween(sfxDot, {Position = UDim2.fromOffset(23, 3)}, 0.2)
        else
            Tween(sfxToggleBtn, {BackgroundColor3 = theme.Quaternary}, 0.2)
            Tween(sfxDot, {Position = UDim2.fromOffset(3, 3)}, 0.2)
        end
