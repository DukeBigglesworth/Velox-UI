-- Decodes or applies a custom tag
function Velox:ApplyNametagToPlayer(player, tagConfig)
    if not player or not tagConfig then return end

    local function attach(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        local old = head:FindFirstChild("VeloxNametag")
        if old then old:Destroy() end

        local tagColor = tagConfig.Color or Color3.fromRGB(90, 140, 255)
        local tagTitle = tagConfig.Title or "SCRIPT USER"
        local tagSubtitle = tagConfig.Subtitle or "Verified"
        local tagIcon = tagConfig.Icon or Velox.Icons.Crown
        local animType = tagConfig.Animation or "None"

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "VeloxNametag"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(200, 54)
        billboard.StudsOffset = Vector3.new(0, tagConfig.Height or 2.8, 0)
        billboard.AlwaysOnTop = true
        billboard.ResetOnSpawn = false
        billboard.Parent = head

        local pill = Create("Frame", {
            BackgroundColor3 = tagConfig.BgColor or Color3.fromRGB(12, 13, 18),
            BackgroundTransparency = tagConfig.BgTransparency or 0.15,
            Size = UDim2.fromScale(1, 1),
            ClipsDescendants = true,
            Parent = billboard
        })
        corner(pill, 12)
        local stroke = AddLitStroke(pill, {BorderLight = Color3.fromRGB(255, 255, 255), Accent = tagColor, BorderDark = Color3.fromRGB(30, 30, 40)}, 1.2, 0.4)

        -- Custom Background Image if provided
        if tagConfig.BgImage and tagConfig.BgImage ~= "" then
            Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = tagConfig.BgImage,
                ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1),
                Parent = pill
            })
        end

