-- Zero dark backdrop, zero border box: Letters expand outward from center
-- into "Velox UI" and materialize floating directly over the 3D game screen!
function Velox:PlayLoadingScreen(theme, onComplete)
    theme = theme or self.Themes.Obsidian

    local loaderGui = Create("ScreenGui", {
        Name = "Velox_Materialize_Loader",
        DisplayOrder = 99999,
        ResetOnSpawn = false,
        Parent = GuiParent
    })

    -- Stage is completely transparent (No background at all)
    local centerStage = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(560, 160),
        Position = UDim2.fromScale(0.5, 0.45),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = loaderGui
    })

    -- Atmospheric introductory sound
    playSound(self.Sounds.Atmosphere, 0.4, 0.9)

    -- Letters: "V", "E", "L", "O", "X", " ", "U", "I"
    local letterData = {
        {char = "V", offset = -160},
        {char = "E", offset = -105},
        {char = "L", offset = -52},
        {char = "O", offset = 0},
        {char = "X", offset = 52},
        {char = "U", offset = 120},
        {char = "I", offset = 160},
    }

    local letterObjs = {}

    for _, item in ipairs(letterData) do
        local lHolder = Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(48, 64),
            Position = UDim2.new(0.5, 0, 0.4, 0), -- Starts collapsed at center!
            AnchorPoint = Vector2.new(0.5, 0.5),
            Parent = centerStage
        })
        local lScale = Create("UIScale", {Scale = 0.0, Parent = lHolder})

        -- Pure Typography with Dark Outline for 100% readability over ANY scene
        local lbl = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Fonts.Black,
            Text = item.char,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 58,
            TextTransparency = 1,
            TextStrokeColor3 = Color3.fromRGB(10, 14, 25),
            TextStrokeTransparency = 0.2,
            Parent = lHolder
        })

        table.insert(letterObjs, {Holder = lHolder, Scale = lScale, Label = lbl, TargetX = item.offset})
    end

    -- Floating credit: "library by Schwein"
    local subCredit = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0.5, 0, 0, 112),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Font = Fonts.Bold,
        Text = "library by Schwein",
        TextColor3 = theme.Accent,
        TextSize = 14,
        TextTransparency = 1,
        TextStrokeColor3 = Color3.fromRGB(8, 10, 18),
        TextStrokeTransparency = 0.25,
        Parent = centerStage
    })

    task.wait(0.25)

    -- Materialize & expand outward individually!
    for i, item in ipairs(letterObjs) do
        playSound(self.Sounds.Materialize, 0.35, 1.0)
        -- Fluid outward explosion from center to slot
        Tween(item.Holder, {Position = UDim2.new(0.5, item.TargetX, 0.4, 0)}, 0.42, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        Tween(item.Scale, {Scale = 1.0}, 0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        Tween(item.Label, {TextTransparency = 0}, 0.32)
        task.wait(0.14)
    end

    -- Harmonious chord as "library by Schwein" materializes
    task.wait(0.15)
    playSound(self.Sounds.Harmonic, 0.42, 1.05)
    Tween(subCredit, {TextTransparency = 0}, 0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    -- Showcase hold (full 2.0s admiring the pure floating logo!)
    task.wait(2.0)

    -- Outward dissolve exit
    playSound(self.Sounds.Atmosphere, 0.35, 1.1)
    for _, item in ipairs(letterObjs) do
        Tween(item.Scale, {Scale = 1.3}, 0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        Tween(item.Label, {TextTransparency = 1}, 0.32)
    end
    Tween(subCredit, {TextTransparency = 1}, 0.3)

    task.wait(0.42)
    loaderGui:Destroy()

    if onComplete then
        onComplete()
    end
end

