            BackgroundColor3 = tData.Accent,
            Size = UDim2.fromOffset(24, 24),
            Text = "",
            AutoButtonColor = false,
            ZIndex = 53,
            Parent = swatchHolder
        })
        corner(sw, 12)
        AddLitStroke(sw, theme, 1, 0.4)
        AddBouncyClick(sw, function()
            notifyAccent(tData.Accent)
            Velox:Notify({
                Title = "Theme Applied",
                Content = "Switched to " .. tName .. " theme palette.",
                Type = "Success",
                Duration = 2.5
            })
        end)
