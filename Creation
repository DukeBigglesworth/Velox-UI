    function win:CreateTab(name, iconId)
        local tabData = {
            Name = name,
            Elements = {},
        }

        local tabBtn = Create("TextButton", {
            BackgroundColor3 = theme.Tertiary,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 34),
            Text = "",
            AutoButtonColor = false,
            Parent = tabScroll
        })
        corner(tabBtn, 8)

        local tabIcon = nil
        if iconId then
            tabIcon = Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = iconId,
                ImageColor3 = theme.TextDark,
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.fromOffset(10, 9),
                Parent = tabBtn
            })
        end

        local tabLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, iconId and -36 or -16, 1, 0),
            Position = UDim2.fromOffset(iconId and 32 or 10, 0),
            Font = Fonts.Semi,
            Text = name,
            TextColor3 = theme.TextDim,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = tabBtn
        })

        local tabActiveIndicator = Create("Frame", {
            BackgroundColor3 = accentColor,
            Size = UDim2.fromOffset(3, 18),
            Position = UDim2.fromOffset(0, 8),
            Visible = false,
            Parent = tabBtn
        })
        corner(tabActiveIndicator, 2)
        table.insert(accentSubscribers, function(c) tabActiveIndicator.BackgroundColor3 = c end)

        local tabContainer = Create("ScrollingFrame", {
            Name = name .. "_Tab",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = theme.Tertiary,
            BorderSizePixel = 0,
            Visible = false,
            Parent = content
        })
        local tabElemLayout = list(tabContainer, 7)
        tabElemLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContainer.CanvasSize = UDim2.new(0, 0, 0, tabElemLayout.AbsoluteContentSize.Y + 12)
        end)
        tabData.Container = tabContainer

        local function activateTab()
            for _, t in ipairs(win.Tabs) do
                t.Container.Visible = false
                Tween(t.Button, {BackgroundTransparency = 1}, 0.2)
                Tween(t.Label, {TextColor3 = theme.TextDim}, 0.2)
                if t.Icon then Tween(t.Icon, {ImageColor3 = theme.TextDark}, 0.2) end
                t.Indicator.Visible = false
            end
            tabContainer.Visible = true
            Tween(tabBtn, {BackgroundTransparency = 0.5}, 0.2)
            Tween(tabLabel, {TextColor3 = theme.Text}, 0.2)
            if tabIcon then Tween(tabIcon, {ImageColor3 = accentColor}, 0.2) end
            tabActiveIndicator.Visible = true
            win.CurrentTab = tabData
        end

        tabBtn.MouseButton1Click:Connect(function()
            playSound(Velox.Sounds.Click, 0.25)
            activateTab()
        end)

        tabData.Button = tabBtn
        tabData.Label = tabLabel
        tabData.Icon = tabIcon
        tabData.Indicator = tabActiveIndicator

        table.insert(win.Tabs, tabData)

        if #win.Tabs == 1 then
            activateTab()
        end

