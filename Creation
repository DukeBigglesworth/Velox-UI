    local duration = opts.Duration or 3.5

    ensureNotifs()
    playSound(self.Sounds.Notify, 0.35)

    local colors = {
        Success = self.Themes.Obsidian.Success,
        Error   = self.Themes.Obsidian.Error,
        Warning = self.Themes.Obsidian.Warning,
        Info    = self.Themes.Obsidian.Info,
