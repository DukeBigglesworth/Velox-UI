    local scaleDragging = false
    scaleTrack.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            scaleDragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            scaleDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if scaleDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((inp.Position.X - scaleTrack.AbsolutePosition.X) / scaleTrack.AbsoluteSize.X, 0, 1)
            scaleFill.Size = UDim2.fromScale(rel, 1)
            local scaleVal = 0.8 + (rel * 0.4)
            mainScale.Scale = scaleVal
            scaleLabel.Text = string.format("UI Zoom Scale: %d%%", math.round(scaleVal * 100))
