function Velox:CreateWatermark(title)
    local screenGui = Create("ScreenGui", {
        Name = "Velox_Watermark",
        ResetOnSpawn = false,
        DisplayOrder = 99,
        Parent = (RunService:IsStudio() and LocalPlayer:WaitForChild("PlayerGui")) or CoreGui
    })

    local watermark = Create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.fromOffset(260, 30),
        Position = UDim2.fromOffset(18, 18),
        Parent = screenGui
    })
    AddCorner(watermark, 6)
    AddLitStroke(watermark, 1, 0.7)

    local label = Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamMedium,
        TextColor3 = Theme.TextDim,
        TextSize = 11,
        Text = title or "VELOX UI  |  FPS: --  |  PING: --",
        Parent = watermark
    })

    local fps = 0
    RunService.RenderStepped:Connect(function(dt)
        fps = math.floor(1 / dt)
    end)

    task.spawn(function()
        while watermark and watermark.Parent do
            local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            label.Text = string.format("%s  •  %d FPS  •  %dms", title or "VELOX", fps, ping)
            task.wait(0.5)
        end
    end)

    return watermark
end

