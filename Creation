            Position = UDim2.fromOffset(8, 0),
            Font = Fonts.Semi,
            Text = tName,
            TextColor3 = theme.Text,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        local sw = Create("TextButton", {
            BackgroundColor3 = state and theme.Accent or theme.Tertiary,
            Size = UDim2.fromOffset(34, 18),
            Position = UDim2.new(1, -42, 0.5, -9),
            Text = "",
            AutoButtonColor = false,
            Parent = card
        })
        corner(sw, 9)

        local dot = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            Size = UDim2.fromOffset(12, 12),
            Position = state and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3),
            Parent = sw
        })
        corner(dot, 6)

        AddBouncyClick(sw, function()
            state = not state
            playSound(Velox.Sounds.Toggle, 0.28)
            if state then
                Tween(sw, {BackgroundColor3 = theme.Accent}, 0.18)
                Tween(dot, {Position = UDim2.fromOffset(19, 3)}, 0.18)
            else
                Tween(sw, {BackgroundColor3 = theme.Tertiary}, 0.18)
                Tween(dot, {Position = UDim2.fromOffset(3, 3)}, 0.18)
            end
            if cb then cb(state) end
        end)
    end

    function subWindowObj:CreateSlider(opts)
        opts = opts or {}
        local sName = opts.Name or "Slider"
        local minVal = opts.Min or 0
        local maxVal = opts.Max or 100
        local curVal = opts.Default or minVal
        local suffix = opts.Suffix or ""
        local cb = opts.Callback

        local card = Create("Frame", {
            BackgroundColor3 = theme.Secondary,
            Size = UDim2.new(1, 0, 0, 44),
            Parent = container
        })
        corner(card, 6)
        AddLitStroke(card, theme, 1, 0.75)

        Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -60, 0, 16),
            Position = UDim2.fromOffset(8, 4),
            Font = Fonts.Semi,
            Text = sName,
            TextColor3 = theme.Text,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        local valLbl = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(50, 16),
            Position = UDim2.new(1, -58, 0, 4),
            Font = Fonts.Bold,
            Text = tostring(curVal) .. suffix,
            TextColor3 = theme.Accent,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = card
        })

        local track = Create("TextButton", {
            BackgroundColor3 = theme.InputBackground,
            Size = UDim2.new(1, -16, 0, 6),
            Position = UDim2.fromOffset(8, 26),
            Text = "",
            AutoButtonColor = false,
            Parent = card
        })
        corner(track, 3)

        local fill = Create("Frame", {
            BackgroundColor3 = theme.Accent,
            Size = UDim2.fromScale(math.clamp((curVal - minVal) / (maxVal - minVal), 0, 1), 1),
            Parent = track
        })
        corner(fill, 3)

        local sliding = false
        local function update(input)
            local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            curVal = math.round(minVal + (relX * (maxVal - minVal)))
            valLbl.Text = tostring(curVal) .. suffix
            fill.Size = UDim2.fromScale(relX, 1)
            if cb then cb(curVal) end
        end

        track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                update(inp)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                update(inp)
            end
        end)
    end

    function subWindowObj:CreateButton(opts)
        opts = opts or {}
        local bName = opts.Name or "Button"
        local cb = opts.Callback

        local btn = Create("TextButton", {
            BackgroundColor3 = theme.Tertiary,
            Size = UDim2.new(1, 0, 0, 28),
            Font = Fonts.Bold,
            Text = bName,
            TextColor3 = theme.Text,
            TextSize = 11,
            AutoButtonColor = false,
            Parent = container
        })
        corner(btn, 6)
        AddLitStroke(btn, theme, 1, 0.6)
        AddBouncyClick(btn, cb)
    end

    return subWindowObj
end

function Velox:CreateWindow(cfg)
    cfg = cfg or {}
