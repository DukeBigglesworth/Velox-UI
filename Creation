local function playSound(id, vol, pitch)
    if not id or not Velox.Sounds.Enabled then return end
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = (vol or 0.35) * (Velox.Sounds.Volume / 0.35)
        s.PlaybackSpeed = pitch or 1
        s.Parent = SoundService
        s:Play()
        s.Ended:Connect(function() s:Destroy() end)
    end)
end

local function Create(className, properties)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        inst[k] = v
    end
    return inst
end

local function Tween(object, properties, duration, style, direction)
    local info = TweenInfo.new(
        duration or 0.25,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(object, info, properties)
    tween:Play()
    return tween
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function AddLitStroke(parent, theme, thickness, baseTransparency)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = thickness or 1
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = baseTransparency or 0.5
    stroke.Parent = parent

    local grad = Instance.new("UIGradient")
    grad.Rotation = 90
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, theme.BorderLight),
        ColorSequenceKeypoint.new(0.4, theme.Accent),
        ColorSequenceKeypoint.new(1.0, theme.BorderDark)
    })
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.0, 0.15),
        NumberSequenceKeypoint.new(0.5, 0.5),
        NumberSequenceKeypoint.new(1.0, 0.85)
    })
    grad.Parent = stroke
    return stroke
end

local function pad(parent, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft   = UDim.new(0, l or 0)
    p.PaddingRight  = UDim.new(0, r or 0)
    p.PaddingTop    = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
    return p
end

local function list(parent, spacing, dir, h, v)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, spacing or 6)
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.SortOrder = Enum.SortOrder.LayoutOrder
    if h then l.HorizontalAlignment = h end
    if v then l.VerticalAlignment = v end
    l.Parent = parent
    return l
end

-- Screen-Constrained Draggable Logic (Prevents dragging outside viewport)
local function MakeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput, dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end)

    dragHandle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local cam = workspace.CurrentCamera
            local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)

            local targetW = targetFrame.AbsoluteSize.X
            local targetH = targetFrame.AbsoluteSize.Y

            local desiredX = startPos.X.Offset + delta.X
            local desiredY = startPos.Y.Offset + delta.Y

            -- If AnchorPoint is (0.5, 0.5)
            if targetFrame.AnchorPoint.X == 0.5 and targetFrame.AnchorPoint.Y == 0.5 then
                local halfW = targetW / 2
                local halfH = targetH / 2
                local centerX = (viewport.X * startPos.X.Scale) + desiredX
                local centerY = (viewport.Y * startPos.Y.Scale) + desiredY

                centerX = math.clamp(centerX, halfW + 4, viewport.X - halfW - 4)
                centerY = math.clamp(centerY, halfH + 4, viewport.Y - halfH - 4)

                targetFrame.Position = UDim2.new(0, math.round(centerX), 0, math.round(centerY))
            else
                -- Top-left AnchorPoint (0, 0)
                desiredX = math.clamp(desiredX, 4, viewport.X - targetW - 4)
                desiredY = math.clamp(desiredY, 4, viewport.Y - targetH - 4)
                targetFrame.Position = UDim2.new(startPos.X.Scale, desiredX, startPos.Y.Scale, desiredY)
            end
        end
    end)
end

local function AddBouncyClick(button, callback)
    local scale = button:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", button)
    
    button.MouseButton1Down:Connect(function()
        Tween(scale, {Scale = 0.94}, 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end)
    button.MouseButton1Up:Connect(function()
        Tween(scale, {Scale = 1.0}, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)
    button.MouseLeave:Connect(function()
        Tween(scale, {Scale = 1.0}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end)
    button.MouseButton1Click:Connect(function()
        playSound(Velox.Sounds.Click, 0.3)
        if callback then callback() end
    end)
end

