function Velox:ApplyNametagToPlayer(player, tagConfig)
    if not player or not tagConfig then return end

    local function attach(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        local old = GuiParent:FindFirstChild("VeloxTag_" .. player.UserId)
        if old then old:Destroy() end

        local roleData = self.Roles[tagConfig.Role or self.ActiveRole] or self.Roles.Owner
        local tagColor = tagConfig.Color or roleData.Color or Color3.fromRGB(90, 140, 255)
        local tagTitle = tagConfig.Title or roleData.Title or "SCRIPT USER"
        local tagSubtitle = tagConfig.Subtitle or roleData.Subtitle or "Verified Tagholder"
        local tagIcon = tagConfig.Icon or roleData.Icon or Velox.Icons.Crown
        local animType = tagConfig.Animation or roleData.Animation or "None"

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "VeloxTag_" .. player.UserId
        billboard.Adornee = head
        billboard.Size = UDim2.new(4.2, 0, 1.35, 0)
        billboard.StudsOffset = Vector3.new(0, tagConfig.Height or 2.3, 0)
        billboard.DistanceLowerLimit = 10
        billboard.DistanceUpperLimit = 75
        billboard.MaxDistance = tagConfig.MaxDistance or 85
        billboard.AlwaysOnTop = true
        billboard.ResetOnSpawn = false
        billboard.Enabled = self.NametagsEnabled
        billboard.Parent = GuiParent

        local pill = Create("Frame", {
            BackgroundColor3 = tagConfig.BgColor or Color3.fromRGB(12, 13, 18),
            BackgroundTransparency = tagConfig.BgTransparency or 0.15,
            Size = UDim2.fromScale(1, 1),
            ClipsDescendants = true,
            Parent = billboard
        })
        corner(pill, 9)
        local stroke = AddLitStroke(pill, {BorderLight = Color3.fromRGB(255, 255, 255), Accent = tagColor, BorderDark = Color3.fromRGB(30, 30, 40)}, 1.2, 0.4)

        if tagConfig.BgImage and tagConfig.BgImage ~= "" then
            local resolvedBg = Velox.LoadWebAsset(tagConfig.BgImage)
            Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = resolvedBg,
                ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1),
                Parent = pill
            })
        end

        local iconImg = nil
        if tagIcon and tagIcon ~= "" then
            local resolvedIcon = Velox.LoadWebAsset(tagIcon)
            iconImg = Create("ImageLabel", {
                BackgroundTransparency = 1,
                Image = resolvedIcon,
                ImageColor3 = (tagIcon:find("rbxassetid") or tagIcon:find("http")) and Color3.fromRGB(255, 255, 255) or tagColor,
                Size = UDim2.fromScale(0.18, 0.65),
                Position = UDim2.fromScale(0.04, 0.18),
                Parent = pill
            })
            corner(iconImg, 4)
        end

        local textX = (tagIcon and tagIcon ~= "") and 0.24 or 0.08
        local textW = (tagIcon and tagIcon ~= "") and 0.72 or 0.88

        local titleLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(textW, 0, 0.45, 0),
            Position = UDim2.new(textX, 0, 0.1, 0),
            Font = Fonts.Bold,
            Text = tagTitle,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = pill
        })

        local subtitleLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(textW, 0, 0.35, 0),
            Position = UDim2.new(textX, 0, 0.52, 0),
            Font = Fonts.Semi,
            Text = tagSubtitle,
            TextColor3 = tagColor,
            TextScaled = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = pill
        })

        if player == LocalPlayer then
            task.spawn(function()
                while billboard and billboard.Parent do
                    local cam = workspace.CurrentCamera
                    if cam and head and head.Parent then
                        local dist = (cam.CFrame.Position - head.Position).Magnitude
                        billboard.Enabled = self.NametagsEnabled and (dist >= 2.0)
                    end
                    RunService.Heartbeat:Wait()
                end
            end)
        end

        if animType == "Rainbow" or animType == "Chroma Wave" then
            task.spawn(function()
                local hue = 0
                while billboard and billboard.Parent do
                    hue = (hue + 0.012) % 1
                    local col = Color3.fromHSV(hue, 0.85, 1)
                    subtitleLabel.TextColor3 = col
                    if stroke then stroke.Color = col end
                    RunService.Heartbeat:Wait()
                end
            end)
        elseif animType == "Pulse" then
            task.spawn(function()
                while billboard and billboard.Parent do
                    Tween(pill, {BackgroundTransparency = 0.5}, 0.8)
                    task.wait(0.8)
                    Tween(pill, {BackgroundTransparency = 0.1}, 0.8)
                    task.wait(0.8)
                end
            end)
        elseif animType == "Bobbing" then
            task.spawn(function()
                local t = 0
                while billboard and billboard.Parent do
                    t = t + 0.06
                    billboard.StudsOffset = Vector3.new(0, (tagConfig.Height or 2.3) + (math.sin(t) * 0.2), 0)
                    RunService.Heartbeat:Wait()
                end
            end)
        elseif animType == "Neon Glow" then
            task.spawn(function()
                local t = 0
                while billboard and billboard.Parent do
                    t = t + 0.08
                    local alpha = (math.sin(t) + 1) / 2
                    if stroke then stroke.Transparency = 0.15 + (alpha * 0.6) end
                    RunService.Heartbeat:Wait()
                end
            end)
        end
    end

    if player.Character then task.spawn(attach, player.Character) end
    player.CharacterAdded:Connect(attach)
end

