function Velox:CreateNametag(options)
    options = options or {}
    local player = options.Player or LocalPlayer
    local title = options.Title or "SCRIPT USER"
    local subtitle = options.Subtitle or "Powered by Velox"
    local color = options.Color or Color3.fromRGB(90, 140, 255)
    local icon = options.Icon or self.Icons.Flame
    local alwaysOnTop = options.AlwaysOnTop ~= false
    local maxDist = options.MaxDistance or 150
    local offset = options.Offset or Vector3.new(0, 2.7, 0)

    local currentTag = nil

    local function attach(char)
        if not char then return end
        local head = char:WaitForChild("Head", 6)
        if not head then return end

        local existing = head:FindFirstChild("VeloxNametag")
        if existing then existing:Destroy() end

        local bb = Create("BillboardGui", {
            Name = "VeloxNametag",
            Adornee = head,
            Size = UDim2.fromOffset(200, 52),
            StudsOffset = offset,
            AlwaysOnTop = alwaysOnTop,
            MaxDistance = maxDist,
            ResetOnSpawn = false,
            Parent = head
        })

        local card = Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(11, 12, 16),
            BackgroundTransparency = 0.15,
            Size = UDim2.fromScale(1, 1),
            Parent = bb
        })
        corner(card, 10)
        AddLitStroke(card, self.Themes.Obsidian, 1, 0.5)

        local bar = Create("Frame", {
            BackgroundColor3 = color,
            Size = UDim2.new(0, 4, 1, -12),
            Position = UDim2.fromOffset(6, 6),
            BorderSizePixel = 0,
            Parent = card
        })
        corner(bar, 2)

        local ic = Create("ImageLabel", {
            BackgroundTransparency = 1,
            Image = icon,
            ImageColor3 = color,
            Size = UDim2.fromOffset(22, 22),
            Position = UDim2.fromOffset(16, 15),
            Parent = card
        })

        local tLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -48, 0, 18),
            Position = UDim2.fromOffset(46, 9),
            Font = Fonts.Bold,
            Text = title,
            TextColor3 = Color3.fromRGB(250, 250, 255),
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        local sLabel = Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -48, 0, 14),
            Position = UDim2.fromOffset(46, 28),
            Font = Fonts.Main,
            Text = subtitle,
            TextColor3 = Color3.fromRGB(170, 175, 190),
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = card
        })

        currentTag = {
            Billboard = bb,
            Bar = bar,
            Icon = ic,
            TitleLabel = tLabel,
            SubtitleLabel = sLabel,
            SetTitle = function(newTitle) tLabel.Text = newTitle end,
            SetSubtitle = function(newSub) sLabel.Text = newSub end,
            SetColor = function(newCol)
                Tween(bar, {BackgroundColor3 = newCol}, 0.25)
                Tween(ic, {ImageColor3 = newCol}, 0.25)
            end,
            Destroy = function() bb:Destroy() end
        }
        return currentTag
    end

    attach(player.Character)
    player.CharacterAdded:Connect(attach)

    return currentTag
end

