        BackgroundColor3 = theme.Tertiary,
        Size = UDim2.new(1, 0, 0, 60),
        ZIndex = 51,
        Parent = settingsModal
    })
    corner(themeBox, 8)
    Create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 0, 18),
        Position = UDim2.fromOffset(8, 6),
        Font = Fonts.Semi,
        Text = "Theme Preset Palette",
        TextColor3 = theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 52,
        Parent = themeBox
    })
    local swatchHolder = Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 0, 26),
        Position = UDim2.fromOffset(8, 26),
        ZIndex = 52,
        Parent = themeBox
    })
    list(swatchHolder, 6, Enum.FillDirection.Horizontal)

    local accentSubscribers = {}
    local function notifyAccent(newColor)
        accentColor = newColor
        Tween(customizerTitle, {TextColor3 = newColor}, 0.25)
        for _, sub in ipairs(accentSubscribers) do
            pcall(sub, newColor)
        end
    end

